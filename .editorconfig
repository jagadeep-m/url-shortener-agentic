root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,csproj,props}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:suggestion

[*.md]
trim_trailing_whitespace = false

# EF Core writes migrations with a UTF-8 byte order mark; they are generated code, not hand-formatted.
[src/UrlShortener.Infrastructure/Migrations/*.cs]
charset = utf-8-bom
generated_code = true
