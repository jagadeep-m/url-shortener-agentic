+    private static string NormalizeTarget(string original)
+    {
+        var uri = new Uri(original);
+        var builder = new UriBuilder(uri)
+        {
+            Scheme = uri.Scheme.ToLowerInvariant(),
+            Host = uri.Host.ToLowerInvariant()
+        };
+
+        if ((builder.Scheme == Uri.UriSchemeHttp && uri.Port == 80)
+            || (builder.Scheme == Uri.UriSchemeHttps && uri.Port == 443))
+            builder.Port = -1;
+
+        // Extract the query from the submitted text so retained segments are not re-encoded.
+        var fragmentIndex = original.IndexOf('#');
+        var queryIndex = original.IndexOf('?');
+        if (queryIndex >= 0 && (fragmentIndex < 0 || queryIndex < fragmentIndex))
+        {
+            var queryEnd = fragmentIndex < 0 ? original.Length : fragmentIndex;
+            var rawQuery = original[(queryIndex + 1)..queryEnd];
+            var retainedSegments = new List<string>();
+            var hasRetainedParameter = false;
+
+            foreach (var segment in rawQuery.Split('&'))
+            {
+                var equalsIndex = segment.IndexOf('=');
+                var name = equalsIndex < 0 ? segment : segment[..equalsIndex];
+                if (Uri.UnescapeDataString(name).StartsWith("utm_", StringComparison.OrdinalIgnoreCase))
+                    continue;
+
+                retainedSegments.Add(segment);
+                if (segment.Length > 0)
+                    hasRetainedParameter = true;
+            }
+
+            builder.Query = hasRetainedParameter ? string.Join("&", retainedSegments) : string.Empty;
+        }
+
+        return builder.ToString();
+    }
+
     private static bool IsLoopbackHost(string host) => host.TrimEnd('.').Equals("localhost", StringComparison.OrdinalIgnoreCase)
         || (IPAddress.TryParse(host.Trim('[', ']'), out var address) && IPAddress.IsLoopback(address));
 
