+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class LinkNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateLink_ReturnsAndPersistsNormalizedTarget()
+    {
+        using var client = factory.Client();
+        var alias = $"n-{Guid.NewGuid():N}"[..22];
+        const string normalized = "https://example.com/path?keep=one#section";
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new
+        {
+            longUrl = "HTTPS://Example.COM:443/path?utm_source=campaign&keep=one#section",
+            customAlias = alias
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var responseBody = await response.Content.ReadAsStringAsync();
+        using var responseJson = JsonDocument.Parse(responseBody);
+        Assert.Equal(normalized, responseJson.RootElement.GetProperty("longUrl").GetString());
+        Assert.Equal(alias, responseJson.RootElement.GetProperty("code").GetString());
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var savedLink = await db.ShortLinks.AsNoTracking().SingleAsync(link => link.Code == alias);
+        Assert.Equal(normalized, savedLink.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateLink_InvalidTargetReturnsProblemDetailsAndDoesNotSaveLink()
+    {
+        using var client = factory.Client();
+        var alias = $"b-{Guid.NewGuid():N}"[..22];
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new
+        {
+            longUrl = "javascript:alert(1)",
+            customAlias = alias
+        });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var responseBody = await response.Content.ReadAsStringAsync();
+        using var responseJson = JsonDocument.Parse(responseBody);
+        Assert.True(responseJson.RootElement.TryGetProperty("errors", out _));
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var savedLink = await db.ShortLinks.AsNoTracking().SingleOrDefaultAsync(link => link.Code == alias);
+        Assert.Null(savedLink);
+    }
+}
