@@ -0,0 +1,138 @@
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LinkNormalizationTests
+{
+    [Fact]
+    public async Task CreateAsync_LowercasesSchemeAndHost_RemovesHttpDefaultPort_AndStripsUtmParameters()
+    {
+        var service = CreateService(out var creation);
+
+        var link = await service.CreateAsync(
+            new CreateLinkRequest("HTTP://EXAMPLE.COM:80/path?keep=First&utm_source=x&UTM_medium=y&u%74m_campaign=z&keep=%2f#Frag"),
+            null,
+            Array.Empty<string>());
+
+        Assert.Equal("http://example.com/path?keep=First&keep=%2f#Frag", link.LongUrl);
+        Assert.Equal(link.LongUrl, creation.CreatedLink!.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateAsync_RemovesHttpsDefaultPort_AndOmitsQueryWhenOnlyUtmParametersRemain()
+    {
+        var service = CreateService(out _);
+
+        var link = await service.CreateAsync(
+            new CreateLinkRequest("HTTPS://ExAmPlE.COM:443/path?utm_source=campaign&UTM_medium=email#section"),
+            null,
+            Array.Empty<string>());
+
+        Assert.Equal("https://example.com/path#section", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateAsync_PreservesNonDefaultPortAndRetainedQueryParameterOrder()
+    {
+        var service = CreateService(out _);
+
+        var link = await service.CreateAsync(
+            new CreateLinkRequest("HTTP://ExAmPlE.COM:8080/path?first=one&utm_term=remove&second=two#frag"),
+            null,
+            Array.Empty<string>());
+
+        Assert.Equal("http://example.com:8080/path?first=one&second=two#frag", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateAsync_InvalidUrlFailsValidationWithoutPersisting()
+    {
+        var service = CreateService(out var creation);
+
+        await Assert.ThrowsAsync<ValidationException>(() => service.CreateAsync(
+            new CreateLinkRequest("javascript:alert(1)"),
+            null,
+            Array.Empty<string>()));
+
+        Assert.Null(creation.CreatedLink);
+    }
+
+    [Fact]
+    public async Task CreateAsync_TargetingOwnHostFailsWithoutPersisting()
+    {
+        var service = CreateService(out var creation);
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() => service.CreateAsync(
+            new CreateLinkRequest("HTTP://LOCALHOST:80/path?utm_source=campaign"),
+            null,
+            new[] { "localhost" }));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Null(creation.CreatedLink);
+    }
+
+    private static LinkService CreateService(out CreationRepository creation)
+    {
+        creation = new CreationRepository();
+        return new LinkService(
+            new CreateLinkValidator(),
+            creation,
+            new LinkRepository(),
+            new RedirectStore(),
+            new StatsRepository(),
+            new Generator(),
+            new FixedClock());
+    }
+
+    private sealed class CreationRepository : ILinkCreationRepository
+    {
+        public ShortLink? CreatedLink { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            CreatedLink = link;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+    }
+
+    private sealed class LinkRepository : IShortLinkRepository
+    {
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+
+        public Task<bool> DisableAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+    }
+
+    private sealed class RedirectStore : IRedirectStore
+    {
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) => Task.FromResult<ShortLink?>(null);
+        public Task<bool> DisableAsync(string code, CancellationToken ct) => Task.FromResult(false);
+    }
+
+    private sealed class StatsRepository : ILinkStatsRepository
+    {
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            Task.FromResult(new LinkStats(0, Array.Empty<DailyClicks>(), Array.Empty<ReferrerClicks>()));
+    }
+
+    private sealed class Generator : ICodeGenerator
+    {
+        public string Generate() => "abc1234";
+    }
+
+    private sealed class FixedClock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 20, 12, 0, 0, TimeSpan.Zero);
+    }
+}
