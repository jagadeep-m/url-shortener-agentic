+using System.Text.Json;
+using UrlShortener.Application.Links;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class ClickLimitTests
+{
+    private static readonly DateTime Now = new(2026, 10, 19, 9, 0, 0, DateTimeKind.Utc);
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-5)]
+    public void LimitMustBePositive(int limit) =>
+        Assert.Throws<ArgumentOutOfRangeException>(() => new ShortLink("capped", "https://example.com", Now, maxClicks: limit));
+
+    [Fact]
+    public void LinkUnderItsLimitIsAvailableAndUnlimitedByDefault()
+    {
+        Assert.True(new ShortLink("capped", "https://example.com", Now, maxClicks: 1).IsAvailableAt(Now));
+        Assert.Null(new ShortLink("open", "https://example.com", Now).MaxClicks);
+    }
+
+    [Theory]
+    [InlineData(null, true)]
+    [InlineData(1, true)]
+    [InlineData(1_000_000, true)]
+    [InlineData(0, false)]
+    [InlineData(1_000_001, false)]
+    public void ValidatorBoundsMaxClicks(int? limit, bool valid) =>
+        Assert.Equal(valid, new CreateLinkValidator().Validate(new CreateLinkRequest("https://example.com", MaxClicks: limit)).IsValid);
+
+    [Fact]
+    public void UnsetLimitKeepsExistingIdempotencyFingerprints() =>
+        Assert.Equal("{\"LongUrl\":\"https://example.com\",\"CustomAlias\":null,\"ExpiresAt\":null}",
+            JsonSerializer.Serialize(new CreateLinkRequest("https://example.com")));
+}
