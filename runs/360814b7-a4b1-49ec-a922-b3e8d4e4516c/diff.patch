+using System.Diagnostics;
+using System.Net;
+using System.Net.Http.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class ClickLimitApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task RedirectStopsWith410OnceTheClickLimitIsReached()
+    {
+        using var client = factory.Client();
+        using var created = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com/limited", MaxClicks: 2));
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var link = (await created.Content.ReadFromJsonAsync<LinkResponse>())!;
+        for (var i = 0; i < 2; i++)
+        {
+            using var redirect = await client.GetAsync($"/{link.Code}");
+            Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        }
+        var stopwatch = Stopwatch.StartNew();
+        LinkDetails? details;
+        do
+        {
+            details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+            if (details!.ClickCount == 2) break;
+            await Task.Delay(25);
+        } while (stopwatch.Elapsed < TimeSpan.FromSeconds(10));
+        Assert.Equal(2, details!.ClickCount);
+        Assert.Equal(2, details.MaxClicks);
+        using var blocked = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Gone, blocked.StatusCode);
+    }
+
+    [Fact]
+    public async Task InvalidLimitIsRejectedWith400()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com", MaxClicks: 0));
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task LinksWithoutALimitKeepRedirecting()
+    {
+        using var client = factory.Client();
+        using var created = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com/open"));
+        var link = (await created.Content.ReadFromJsonAsync<LinkResponse>())!;
+        for (var i = 0; i < 3; i++)
+        {
+            using var redirect = await client.GetAsync($"/{link.Code}");
+            Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        }
+        Assert.Null((await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}"))!.MaxClicks);
+    }
+}
