@@ -0,0 +1,69 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class CappedLinkConcurrencyTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task ConcurrentRedirectsRecordAtMostTheClickLimit()
+    {
+        const int maxClicks = 5;
+        const int requestCount = 24;
+        var alias = "race-" + Guid.NewGuid().ToString("N")[..12];
+
+        using var client = factory.Client();
+        using var created = await client.PostAsJsonAsync("/api/v1/links",
+            new CreateLinkRequest("https://example.com/concurrent-click-limit", alias, MaxClicks: maxClicks));
+
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var link = await created.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(link);
+        Assert.Equal(alias, link.Code);
+
+        var pendingResponses = Enumerable.Range(0, requestCount)
+            .Select(_ => client.GetAsync($"/{link.Code}"))
+            .ToArray();
+        var responses = await Task.WhenAll(pendingResponses);
+
+        try
+        {
+            var redirects = responses.Where(response => response.StatusCode == HttpStatusCode.Found).ToArray();
+            var exhausted = responses.Where(response => response.StatusCode == HttpStatusCode.Gone).ToArray();
+
+            Assert.Equal(maxClicks, redirects.Length);
+            Assert.Equal(requestCount - maxClicks, exhausted.Length);
+            Assert.All(responses, response => Assert.True(
+                response.StatusCode is HttpStatusCode.Found or HttpStatusCode.Gone,
+                $"Unexpected response status: {(int)response.StatusCode}."));
+            Assert.All(redirects, response => Assert.Equal(link.LongUrl, response.Headers.Location!.AbsoluteUri));
+
+            foreach (var response in exhausted)
+            {
+                Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+                var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+                Assert.Equal((int)HttpStatusCode.Gone, body.GetProperty("status").GetInt32());
+                Assert.Equal("The link has reached its click limit.", body.GetProperty("detail").GetString());
+            }
+
+            await using var scope = factory.Services.CreateAsyncScope();
+            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+            var storedLink = await db.ShortLinks.AsNoTracking().SingleAsync(item => item.Code == link.Code);
+
+            Assert.Equal(maxClicks, storedLink.MaxClicks);
+            Assert.Equal((long)maxClicks, storedLink.ClickCount);
+            Assert.Equal(maxClicks, await db.ClickEvents.CountAsync(item => item.ShortLinkId == storedLink.Id));
+        }
+        finally
+        {
+            foreach (var response in responses)
+                response.Dispose();
+        }
+    }
+}
