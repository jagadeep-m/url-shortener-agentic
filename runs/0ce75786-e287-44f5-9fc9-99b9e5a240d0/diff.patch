diff --git a/tests/UrlShortener.UnitTests/ClickLimitTests.cs b/tests/UrlShortener.UnitTests/ClickLimitTests.cs
new file mode 100644
index 0000000..81f2183
--- /dev/null
+++ b/tests/UrlShortener.UnitTests/ClickLimitTests.cs
@@ -0,0 +1,120 @@
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class ClickLimitTests
+{
+    private static readonly DateTime Now = new(2026, 10, 17, 12, 0, 0, DateTimeKind.Utc);
+
+    private sealed class ClickRepository : IClickEventRepository
+    {
+        public bool Result { get; set; } = true;
+        public int CappedCalls { get; private set; }
+        public int? LastMaxClicks { get; private set; }
+
+        public Task<bool> RecordAsync(ClickEvent clickEvent, CancellationToken cancellationToken = default) =>
+            Task.FromResult(Result);
+
+        public Task<bool> RecordCappedAsync(ClickEvent clickEvent, int maxClicks, CancellationToken cancellationToken = default)
+        {
+            CappedCalls++;
+            LastMaxClicks = maxClicks;
+            return Task.FromResult(Result);
+        }
+
+        public Task<IReadOnlyList<ClickEvent>> GetByShortLinkIdAsync(long shortLinkId,
+            CancellationToken cancellationToken = default) =>
+            Task.FromResult<IReadOnlyList<ClickEvent>>(Array.Empty<ClickEvent>());
+    }
+
+    private static LinkService CreateService(IClickEventRepository? clickEvents) =>
+        new(new CreateLinkValidator(), null!, null!, null!, null!, null!, TimeProvider.System, clickEvents);
+
+    [Fact]
+    public void DomainAcceptsMissingAndBoundaryClickLimits()
+    {
+        Assert.Null(new ShortLink("abc", "https://example.com", Now).MaxClicks);
+        Assert.Equal(1, new ShortLink("one", "https://example.com", Now, maxClicks: 1).MaxClicks);
+        Assert.Equal(1_000_000, new ShortLink("million", "https://example.com", Now, maxClicks: 1_000_000).MaxClicks);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-1)]
+    [InlineData(1_000_001)]
+    public void DomainRejectsOutOfRangeClickLimits(int maxClicks)
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() =>
+            new ShortLink("abc", "https://example.com", Now, maxClicks: maxClicks));
+    }
+
+    [Fact]
+    public void ValidatorAcceptsMissingAndBoundaryClickLimits()
+    {
+        var validator = new CreateLinkValidator();
+
+        Assert.True(validator.Validate(new CreateLinkRequest("https://example.com")).IsValid);
+        Assert.True(validator.Validate(new CreateLinkRequest("https://example.com", MaxClicks: 1)).IsValid);
+        Assert.True(validator.Validate(new CreateLinkRequest("https://example.com", MaxClicks: 1_000_000)).IsValid);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-1)]
+    [InlineData(1_000_001)]
+    public void ValidatorRejectsOutOfRangeClickLimits(int maxClicks)
+    {
+        var result = new CreateLinkValidator().Validate(
+            new CreateLinkRequest("https://example.com", MaxClicks: maxClicks));
+
+        Assert.False(result.IsValid);
+        Assert.Contains(result.Errors, error => error.PropertyName == nameof(CreateLinkRequest.MaxClicks));
+    }
+
+    [Fact]
+    public async Task CappedClickIsRecordedWithItsLimit()
+    {
+        var repository = new ClickRepository();
+
+        await CreateService(repository).RecordCappedClickAsync(new ClickEvent(42, Now), 3);
+
+        Assert.Equal(1, repository.CappedCalls);
+        Assert.Equal(3, repository.LastMaxClicks);
+    }
+
+    [Fact]
+    public async Task RejectedCappedClickBecomesGoneLinkOperation()
+    {
+        var repository = new ClickRepository { Result = false };
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(repository).RecordCappedClickAsync(new ClickEvent(42, Now), 1));
+
+        Assert.Equal(410, exception.StatusCode);
+        Assert.Equal(1, repository.CappedCalls);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(1_000_001)]
+    public async Task CappedRecordingRejectsInvalidLimitsBeforeRepositoryCall(int maxClicks)
+    {
+        var repository = new ClickRepository();
+
+        await Assert.ThrowsAsync<ArgumentOutOfRangeException>(() =>
+            CreateService(repository).RecordCappedClickAsync(new ClickEvent(42, Now), maxClicks));
+
+        Assert.Equal(0, repository.CappedCalls);
+    }
+
+    [Fact]
+    public async Task CappedRecordingRequiresClickRepository()
+    {
+        await Assert.ThrowsAsync<InvalidOperationException>(() =>
+            CreateService(null).RecordCappedClickAsync(new ClickEvent(42, Now), 1));
+    }
+}
