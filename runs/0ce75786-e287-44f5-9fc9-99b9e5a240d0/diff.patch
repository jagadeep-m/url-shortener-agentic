 {
     // Atomically persists the event and increments the total. False means the link no longer exists.
     Task<bool> RecordAsync(ClickEvent clickEvent, CancellationToken cancellationToken = default);
+
+    // A capped recording must be rejected when the limit has already been reached. The default
+    // implementation fails closed for repositories that have not implemented capped recording.
+    Task<bool> RecordCappedAsync(ClickEvent clickEvent, int maxClicks, CancellationToken cancellationToken = default) =>
+        Task.FromResult(false);
+
+    // This overload retains the existing unlimited recording behavior when no maximum is supplied.
+    Task<bool> RecordAsync(ClickEvent clickEvent, int? maxClicks, CancellationToken cancellationToken = default) =>
+        maxClicks is null
+            ? RecordAsync(clickEvent, cancellationToken)
+            : RecordCappedAsync(clickEvent, maxClicks.Value, cancellationToken);
+
     Task<IReadOnlyList<ClickEvent>> GetByShortLinkIdAsync(long shortLinkId,
         CancellationToken cancellationToken = default);
 }
