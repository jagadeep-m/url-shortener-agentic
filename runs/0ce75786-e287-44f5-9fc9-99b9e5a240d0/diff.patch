+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class CappedLinkApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    private async Task<LinkResponse> CreateLinkAsync(HttpClient client, int? maxClicks)
+    {
+        var alias = "cap-" + Guid.NewGuid().ToString("N")[..12];
+        using var response = await client.PostAsJsonAsync("/api/v1/links",
+            new CreateLinkRequest("https://example.com/click-limit-test", alias, MaxClicks: maxClicks));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var link = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(link);
+        Assert.Equal(alias, link.Code);
+        return link;
+    }
+
+    private static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode expectedStatus)
+    {
+        Assert.Equal(expectedStatus, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)expectedStatus, body.GetProperty("status").GetInt32());
+    }
+
+    [Fact]
+    public async Task CappedLinkRedirectsUpToLimitThenReturnsGoneAndPersistsOnlyAllowedClicks()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, 2);
+
+        for (var click = 0; click < 2; click++)
+        {
+            using var redirect = await client.GetAsync($"/{link.Code}");
+            Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+            Assert.Equal(link.LongUrl, redirect.Headers.Location!.AbsoluteUri);
+        }
+
+        using (var rejected = await client.GetAsync($"/{link.Code}"))
+        {
+            await AssertProblemAsync(rejected, HttpStatusCode.Gone);
+        }
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var storedLink = await db.ShortLinks.AsNoTracking().SingleAsync(item => item.Code == link.Code);
+        Assert.Equal(2, storedLink.MaxClicks);
+        Assert.Equal(2L, storedLink.ClickCount);
+        Assert.Equal(2, await db.ClickEvents.CountAsync(item => item.ShortLinkId == storedLink.Id));
+    }
+
+    [Fact]
+    public async Task ClickLimitOfOneAllowsOneRedirectThenReturnsGone()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, 1);
+
+        using (var allowed = await client.GetAsync($"/{link.Code}"))
+            Assert.Equal(HttpStatusCode.Found, allowed.StatusCode);
+
+        using var rejected = await client.GetAsync($"/{link.Code}");
+        await AssertProblemAsync(rejected, HttpStatusCode.Gone);
+    }
+
+    [Fact]
+    public async Task MaximumSupportedClickLimitIsAccepted()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, 1_000_000);
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var storedLink = await db.ShortLinks.AsNoTracking().SingleAsync(item => item.Code == link.Code);
+        Assert.Equal(1_000_000, storedLink.MaxClicks);
+        Assert.Equal(0L, storedLink.ClickCount);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-1)]
+    [InlineData(1_000_001)]
+    public async Task OutOfRangeClickLimitReturnsValidationProblem(int maxClicks)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links",
+            new CreateLinkRequest("https://example.com/invalid-limit", MaxClicks: maxClicks));
+
+        await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+    }
+
+    [Fact]
+    public async Task LinkWithoutClickLimitContinuesRedirecting()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, null);
+
+        for (var click = 0; click < 2; click++)
+        {
+            using var redirect = await client.GetAsync($"/{link.Code}");
+            Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+            Assert.Equal(link.LongUrl, redirect.Headers.Location!.AbsoluteUri);
+        }
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var storedLink = await db.ShortLinks.AsNoTracking().SingleAsync(item => item.Code == link.Code);
+        Assert.Null(storedLink.MaxClicks);
+    }
+}
