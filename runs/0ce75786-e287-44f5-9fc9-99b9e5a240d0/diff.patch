+using System.Security.Cryptography;
+using System.Text;
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LegacyIdempotencyTests
+{
+    private sealed class FixedClock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class PersistedCreationRepository(IdempotentLink persisted) : ILinkCreationRepository
+    {
+        public int CreateCalls { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(persisted);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            CreateCalls++;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+    }
+
+    private sealed class UnusedRepositories : IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    [Fact]
+    public async Task ReplayAcceptsHashPersistedBeforeMaxClicksWasAdded()
+    {
+        const string legacyJson = "{\"LongUrl\":\"https://example.com/legacy\",\"CustomAlias\":null,\"ExpiresAt\":null}";
+        var legacyHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(legacyJson)));
+        var originalLink = new ShortLink("legacy-link", "https://example.com/legacy",
+            new DateTime(2026, 10, 17, 11, 0, 0, DateTimeKind.Utc));
+        var creation = new PersistedCreationRepository(new IdempotentLink(legacyHash, originalLink));
+        var unused = new UnusedRepositories();
+        var service = new LinkService(new CreateLinkValidator(), creation, unused, unused, unused,
+            new Base62CodeGenerator(), new FixedClock());
+
+        var replayed = await service.CreateAsync(
+            new CreateLinkRequest("https://example.com/legacy"), "existing-key", ["localhost"]);
+
+        Assert.Same(originalLink, replayed);
+        Assert.Equal(0, creation.CreateCalls);
+    }
+}
