+    private static string NormalizeUrl(string url, Uri target)
+    {
+        var schemeEnd = url.IndexOf(':');
+        var authorityStart = schemeEnd + 3;
+        var authorityEnd = url.Length;
+        for (var i = authorityStart; i < url.Length; i++)
+        {
+            if (url[i] is '/' or '?' or '#')
+            {
+                authorityEnd = i;
+                break;
+            }
+        }
+
+        var authority = url[authorityStart..authorityEnd];
+        var userInfoEnd = authority.LastIndexOf('@');
+        var userInfo = userInfoEnd >= 0 ? authority[..(userInfoEnd + 1)] : string.Empty;
+        var hostAndPort = authority[(userInfoEnd + 1)..];
+
+        int hostEnd;
+        if (hostAndPort.StartsWith("[", StringComparison.Ordinal))
+        {
+            hostEnd = hostAndPort.IndexOf(']') + 1;
+        }
+        else
+        {
+            var portSeparator = hostAndPort.LastIndexOf(':');
+            hostEnd = portSeparator >= 0 ? portSeparator : hostAndPort.Length;
+        }
+
+        var host = hostAndPort[..hostEnd].ToLowerInvariant();
+        var portSuffix = hostAndPort[hostEnd..];
+        var defaultPort = target.Scheme.Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase) ? 80 : 443;
+        if (portSuffix.Length > 1 && portSuffix[0] == ':'
+            && int.TryParse(portSuffix.AsSpan(1), NumberStyles.None, CultureInfo.InvariantCulture, out var port)
+            && port == defaultPort)
+        {
+            portSuffix = string.Empty;
+        }
+
+        var normalized = url[..schemeEnd].ToLowerInvariant() + "://" + userInfo + host + portSuffix + url[authorityEnd..];
+        var queryStart = normalized.IndexOf('?');
+        var fragmentStart = normalized.IndexOf('#');
+        if (queryStart < 0 || (fragmentStart >= 0 && queryStart > fragmentStart)) return normalized;
+
+        var queryEnd = fragmentStart < 0 ? normalized.Length : fragmentStart;
+        var rawQuery = normalized[(queryStart + 1)..queryEnd];
+        var parameters = rawQuery.Split('&');
+        var retained = parameters.Where(parameter =>
+        {
+            var equals = parameter.IndexOf('=');
+            var name = equals >= 0 ? parameter[..equals] : parameter;
+            return !name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase);
+        }).ToArray();
+
+        if (retained.Length == parameters.Length) return normalized;
+        var prefix = normalized[..queryStart];
+        var suffix = fragmentStart < 0 ? string.Empty : normalized[fragmentStart..];
+        return retained.Length == 0 ? prefix + suffix : prefix + "?" + string.Join('&', retained) + suffix;
+    }
+
     private static bool IsLoopbackHost(string host) => host.TrimEnd('.').Equals("localhost", StringComparison.OrdinalIgnoreCase)
         || (IPAddress.TryParse(host.Trim('[', ']'), out var address) && IPAddress.IsLoopback(address));
 
