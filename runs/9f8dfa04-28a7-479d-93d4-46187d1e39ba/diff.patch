+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class LinkUrlNormalizationApiTests : IClassFixture<ApiFactory>
+{
+    private readonly ApiFactory factory;
+
+    public LinkUrlNormalizationApiTests(ApiFactory factory)
+    {
+        this.factory = factory;
+    }
+
+    [Theory]
+    [InlineData("HTTP://ExAmPlE.CoM:80/Path", "http://example.com/Path")]
+    [InlineData("hTtPs://EXAMPLE.COM:443/Path", "https://example.com/Path")]
+    [InlineData("HTTPS://EXAMPLE.COM:8443/Path", "https://example.com:8443/Path")]
+    [InlineData("hTtPs://EXAMPLE.COM:8443/Path%2fCase?x=1&utm_source=one&UTM_campaign=two%2Fthree&x=two&notutm_source=keep#Frag%20ment", "https://example.com:8443/Path%2fCase?x=1&x=two&notutm_source=keep#Frag%20ment")]
+    [InlineData("https://EXAMPLE.COM/?utm_source=one&UTM_medium=two", "https://example.com/")]
+    [InlineData("https://EXAMPLE.COM/?empty=&flag&x=a%2Fb&x=two", "https://example.com/?empty=&flag&x=a%2Fb&x=two")]
+    public async Task CreateReturnsAndUsesNormalizedDestination(string input, string expected)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(input));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var responseBody = await response.Content.ReadAsStringAsync();
+        var link = JsonSerializer.Deserialize<LinkResponse>(responseBody, new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        Assert.NotNull(link);
+        Assert.Equal(expected, link.LongUrl);
+        Assert.Equal($"/api/v1/links/{link.Code}", response.Headers.Location!.OriginalString);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(expected, details.LongUrl);
+
+        using var redirect = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.Equal(expected, redirect.Headers.Location!.OriginalString);
+    }
+
+    [Theory]
+    [InlineData("ftp://example.com/file")]
+    [InlineData("/relative/path")]
+    public async Task InvalidDestinationsReturnBadRequestProblemDetails(string destination)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(destination));
+
+        await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+    }
+
+    [Fact]
+    public async Task SelfHostedDestinationReturnsBadRequestProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("http://localhost/path"));
+
+        await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+    }
+
+    [Fact]
+    public async Task IdempotencyKeyStillUsesOriginalRequestWhenDestinationsNormalizeEqually()
+    {
+        using var client = factory.Client();
+        client.DefaultRequestHeaders.Add("Idempotency-Key", Guid.NewGuid().ToString("N"));
+
+        using var first = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://EXAMPLE.com:443/path?utm_source=campaign"));
+        Assert.Equal(HttpStatusCode.Created, first.StatusCode);
+        var firstBody = await first.Content.ReadAsStringAsync();
+        var created = JsonSerializer.Deserialize<LinkResponse>(firstBody, new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        Assert.NotNull(created);
+        Assert.Equal("https://example.com/path", created.LongUrl);
+
+        using var changedOriginalRequest = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com/path"));
+        await AssertProblemAsync(changedOriginalRequest, HttpStatusCode.Conflict);
+    }
+
+    private static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode expectedStatus)
+    {
+        Assert.Equal(expectedStatus, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+
+        var body = await response.Content.ReadAsStringAsync();
+        using var document = JsonDocument.Parse(body);
+        Assert.Equal((int)expectedStatus, document.RootElement.GetProperty("status").GetInt32());
+        Assert.True(document.RootElement.TryGetProperty("type", out _));
+        Assert.True(document.RootElement.TryGetProperty("title", out _));
+    }
+}
