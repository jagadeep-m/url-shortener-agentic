+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LinkUrlNormalizationTests
+{
+    [Theory]
+    [InlineData("HTTP://ExAmPlE.CoM:80/Path", "http://example.com/Path")]
+    [InlineData("hTtPs://EXAMPLE.COM:443/Path", "https://example.com/Path")]
+    [InlineData("HTTPS://EXAMPLE.COM:8443/Path", "https://example.com:8443/Path")]
+    [InlineData("hTtPs://EXAMPLE.COM:8443/Path%2fCase?x=1&utm_source=one&UTM_campaign=two%2Fthree&x=two&notutm_source=keep#Frag%20ment", "https://example.com:8443/Path%2fCase?x=1&x=two&notutm_source=keep#Frag%20ment")]
+    [InlineData("https://EXAMPLE.COM/?utm_source=one&UTM_medium=two", "https://example.com/")]
+    [InlineData("https://EXAMPLE.COM/?empty=&flag&x=a%2Fb&x=two", "https://example.com/?empty=&flag&x=a%2Fb&x=two")]
+    public async Task CreateAsyncStoresNormalizedDestination(string input, string expected)
+    {
+        var (service, creation) = CreateService();
+
+        await service.CreateAsync(new CreateLinkRequest(input), null, Array.Empty<string>());
+
+        var savedLink = Assert.IsType<ShortLink>(creation.CreatedLink);
+        Assert.Equal(expected, savedLink.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateAsyncRejectsInvalidUrlWithoutSavingLink()
+    {
+        var (service, creation) = CreateService();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            service.CreateAsync(new CreateLinkRequest("ftp://example.com/file"), null, Array.Empty<string>()));
+
+        Assert.Null(creation.CreatedLink);
+    }
+
+    [Fact]
+    public async Task CreateAsyncRejectsSelfHostedDestinationWithoutSavingLink()
+    {
+        var (service, creation) = CreateService();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            service.CreateAsync(new CreateLinkRequest("http://localhost/path"), null, new[] { "localhost" }));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Null(creation.CreatedLink);
+    }
+
+    private static (LinkService Service, TestLinkCreationRepository Creation) CreateService()
+    {
+        var creation = new TestLinkCreationRepository();
+        var service = new LinkService(
+            new CreateLinkValidator(),
+            creation,
+            new TestShortLinkRepository(),
+            new TestRedirectStore(),
+            new TestLinkStatsRepository(),
+            new TestCodeGenerator(),
+            TimeProvider.System);
+
+        return (service, creation);
+    }
+
+    private sealed class TestLinkCreationRepository : ILinkCreationRepository
+    {
+        public ShortLink? CreatedLink { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            CreatedLink = link;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+    }
+
+    private sealed class TestShortLinkRepository : IShortLinkRepository
+    {
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+
+        public Task<bool> DisableAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+    }
+
+    private sealed class TestRedirectStore : IRedirectStore
+    {
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) => Task.FromResult<ShortLink?>(null);
+        public Task<bool> DisableAsync(string code, CancellationToken ct) => Task.FromResult(false);
+    }
+
+    private sealed class TestLinkStatsRepository : ILinkStatsRepository
+    {
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            Task.FromResult(new LinkStats(0, Array.Empty<DailyClicks>(), Array.Empty<ReferrerClicks>()));
+    }
+
+    private sealed class TestCodeGenerator : ICodeGenerator
+    {
+        public string Generate() => "abc1234";
+    }
+}
