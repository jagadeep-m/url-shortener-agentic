+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class LinkUrlNormalizationRegressionApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Theory]
+    [InlineData("http://EXAMPLE.COM:80/path?utm_source=campaign&keep=%2F&UTM_medium=email#Frag", "http://example.com/path?keep=%2F#Frag")]
+    [InlineData("https://EXAMPLE.COM:443?utm_campaign=campaign&keep=1", "https://example.com?keep=1")]
+    [InlineData("https://EXAMPLE.COM:443/path?utm_source=campaign", "https://example.com/path")]
+    public async Task DefaultPortRemovalDoesNotPreventTrackingParameterRemoval(string input, string expected)
+    {
+        using var client = factory.Client();
+        var alias = "norm-" + Guid.NewGuid().ToString("N")[..12];
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest(input, alias));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var link = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(link);
+        Assert.Equal(alias, link.Code);
+        Assert.Equal(expected, link.LongUrl);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(expected, details.LongUrl);
+
+        using var redirect = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.Equal(expected, redirect.Headers.Location!.OriginalString);
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var savedLink = await db.ShortLinks.SingleAsync(item => item.Code == alias);
+        Assert.Equal(expected, savedLink.LongUrl);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsProblemDetailsWithoutSavingLink()
+    {
+        using var client = factory.Client();
+        var alias = "norm-" + Guid.NewGuid().ToString("N")[..12];
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest("ftp://example.com/file", alias));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var body = await response.Content.ReadAsStringAsync();
+        using var problem = JsonDocument.Parse(body);
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.RootElement.GetProperty("status").GetInt32());
+        Assert.True(problem.RootElement.TryGetProperty("type", out _));
+        Assert.True(problem.RootElement.TryGetProperty("title", out _));
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        Assert.False(await db.ShortLinks.AnyAsync(item => item.Code == alias));
+    }
+}
