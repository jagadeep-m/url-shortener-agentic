+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizationTests
+{
+    private sealed class Clock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class Store : ILinkCreationRepository, IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public int Calls { get; private set; }
+        public ShortLink? CreatedLink { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            Calls++;
+            CreatedLink = link;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken ct = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult(false);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private sealed class Generator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private static LinkService CreateService(Store store) =>
+        new(new CreateLinkValidator(), store, store, store, store, new Generator(), new Clock());
+
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.com:80/path?keep=one&utm_source=campaign&Keep=two#Section",
+        "http://example.com/path?keep=one&Keep=two#Section")]
+    [InlineData(
+        "HTTPS://ExAmPlE.com:443/path?utm_campaign=spring&lang=en#details",
+        "https://example.com/path?lang=en#details")]
+    [InlineData(
+        "HTTP://ExAmPlE.com:8080/path?lang=en&utm_medium=email#details",
+        "http://example.com:8080/path?lang=en#details")]
+    [InlineData(
+        "HTTPS://ExAmPlE.com:8443/path?utm_source=mail&lang=en#details",
+        "https://example.com:8443/path?lang=en#details")]
+    public async Task CreatePersistsNormalizedUrl(
+        string submittedUrl, string expectedUrl)
+    {
+        var store = new Store();
+        var result = await CreateService(store).CreateAsync(
+            new CreateLinkRequest(submittedUrl), null, ["localhost"]);
+
+        Assert.Equal(expectedUrl, result.LongUrl);
+        Assert.NotNull(store.CreatedLink);
+        Assert.Equal(expectedUrl, store.CreatedLink.LongUrl);
+        Assert.Equal(1, store.Calls);
+    }
+
+    [Fact]
+    public async Task RemovesAllUtmParametersAndOmitsEmptyQueryString()
+    {
+        var store = new Store();
+        var result = await CreateService(store).CreateAsync(
+            new CreateLinkRequest("https://Example.com/path?utm_source=x&UTM_medium=y#part"),
+            null, ["localhost"]);
+
+        Assert.Equal("https://example.com/path#part", result.LongUrl);
+        Assert.Equal(1, store.Calls);
+    }
+
+    [Theory]
+    [InlineData("javascript:alert(1)")]
+    [InlineData("/relative/path")]
+    public async Task InvalidUrlDoesNotPersist(string url)
+    {
+        var store = new Store();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(store).CreateAsync(new CreateLinkRequest(url), null, ["localhost"]));
+
+        Assert.Equal(0, store.Calls);
+        Assert.Null(store.CreatedLink);
+    }
+
+    [Fact]
+    public async Task ServiceOwnedHostDoesNotPersist()
+    {
+        var store = new Store();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(store).CreateAsync(
+                new CreateLinkRequest("https://SHORT.EXAMPLE:8443/path"),
+                null, ["localhost", "short.example"]));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Equal(0, store.Calls);
+        Assert.Null(store.CreatedLink);
+    }
+}
