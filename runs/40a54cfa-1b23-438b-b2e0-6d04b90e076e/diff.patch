@@ -0,0 +1,74 @@
+namespace UrlShortener.Application.Links;
+
+/// <summary>Normalizes an already validated absolute HTTP(S) URL for storage.</summary>
+public static class UrlNormalizer
+{
+    public static string Normalize(string url)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(url);
+
+        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
+            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+            || string.IsNullOrWhiteSpace(uri.Host))
+        {
+            throw new ArgumentException("An absolute HTTP or HTTPS URL is required.", nameof(url));
+        }
+
+        var builder = new UriBuilder(uri)
+        {
+            Scheme = uri.Scheme.ToLowerInvariant(),
+            Host = uri.Host.ToLowerInvariant()
+        };
+
+        if ((uri.Scheme == Uri.UriSchemeHttp && uri.Port == 80)
+            || (uri.Scheme == Uri.UriSchemeHttps && uri.Port == 443))
+        {
+            builder.Port = -1;
+        }
+
+        var schemeSeparator = url.IndexOf("://", StringComparison.Ordinal);
+        if (schemeSeparator < 0)
+        {
+            throw new ArgumentException("An absolute HTTP or HTTPS URL is required.", nameof(url));
+        }
+
+        var authorityStart = schemeSeparator + 3;
+        var authorityEnd = url.IndexOfAny(['/', '?', '#'], authorityStart);
+        if (authorityEnd < 0) authorityEnd = url.Length;
+
+        var remainder = url[authorityEnd..];
+        var fragmentIndex = remainder.IndexOf('#');
+        var queryIndex = remainder.IndexOf('?');
+        if (queryIndex >= 0 && (fragmentIndex < 0 || queryIndex < fragmentIndex))
+        {
+            var queryEnd = fragmentIndex < 0 ? remainder.Length : fragmentIndex;
+            var query = remainder[(queryIndex + 1)..queryEnd];
+            var components = query.Split('&');
+            var remainingComponents = components
+                .Where(component =>
+                {
+                    var equalsIndex = component.IndexOf('=');
+                    var name = equalsIndex < 0 ? component : component[..equalsIndex];
+                    return !name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase);
+                })
+                .ToArray();
+
+            // Empty components are retained alongside remaining parameters, but an empty
+            // query or one containing only removed tracking parameters is omitted.
+            if (remainingComponents.Any(component => component.Length > 0))
+            {
+                remainder = string.Concat(
+                    remainder[..queryIndex],
+                    "?",
+                    string.Join('&', remainingComponents),
+                    remainder[queryEnd..]);
+            }
+            else
+            {
+                remainder = string.Concat(remainder[..queryIndex], remainder[queryEnd..]);
+            }
+        }
+
+        return string.Concat(builder.Uri.GetLeftPart(UriPartial.Authority), remainder);
+    }
+}
