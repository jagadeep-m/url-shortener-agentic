+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateResponseAndRedirectUseNormalizedTarget()
+    {
+        using var client = factory.Client();
+        const string expectedUrl = "https://example.com/docs?lang=en&ref=home#install";
+        using var createResponse = await client.PostAsJsonAsync(
+            "/api/v1/links",
+            new CreateLinkRequest(
+                "HTTPS://ExAmPlE.com:443/docs?utm_source=campaign&lang=en&UTM_medium=email&ref=home#install"));
+
+        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);
+        var createdLink = await createResponse.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(createdLink);
+        Assert.Equal(expectedUrl, createdLink.LongUrl);
+
+        using var redirectResponse = await client.GetAsync($"/{createdLink.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirectResponse.StatusCode);
+        Assert.Equal(expectedUrl, redirectResponse.Headers.Location!.OriginalString);
+    }
+
+    [Theory]
+    [InlineData("javascript:alert(1)")]
+    [InlineData("http://localhost/service-path")]
+    public async Task RejectedTargetsReturnBadRequestProblemDetails(string url)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest(url));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, body.GetProperty("status").GetInt32());
+        Assert.True(body.TryGetProperty("title", out _) || body.TryGetProperty("detail", out _));
+    }
+}
