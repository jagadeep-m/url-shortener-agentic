+using System;
+using System.Linq;
+
+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Normalizes destination URLs before they are saved.
+/// </summary>
+public static class UrlNormalizer
+{
+    /// <summary>
+    /// Lowercases the URL scheme and host, removes the default HTTP or HTTPS port,
+    /// and removes query parameters whose names begin with the exact lowercase
+    /// prefix <c>utm_</c>.
+    /// </summary>
+    /// <param name="url">An absolute destination URL.</param>
+    /// <returns>The normalized URL.</returns>
+    /// <exception cref="ArgumentNullException"><paramref name="url"/> is null.</exception>
+    /// <exception cref="ArgumentException"><paramref name="url"/> is not an absolute URL.</exception>
+    public static string Normalize(string url)
+    {
+        ArgumentNullException.ThrowIfNull(url);
+
+        if (!Uri.TryCreate(url, UriKind.Absolute, out var parsedUri))
+        {
+            throw new ArgumentException("The URL must be absolute.", nameof(url));
+        }
+
+        var builder = new UriBuilder(parsedUri)
+        {
+            Scheme = parsedUri.Scheme.ToLowerInvariant(),
+            Host = parsedUri.Host.ToLowerInvariant()
+        };
+
+        if ((builder.Scheme == Uri.UriSchemeHttp && builder.Port == 80)
+            || (builder.Scheme == Uri.UriSchemeHttps && builder.Port == 443))
+        {
+            builder.Port = -1;
+        }
+
+        var query = parsedUri.Query;
+        if (query.Length > 1)
+        {
+            var retainedParameters = query[1..]
+                .Split('&')
+                .Where(parameter =>
+                {
+                    var separatorIndex = parameter.IndexOf('=');
+                    var name = separatorIndex < 0 ? parameter : parameter[..separatorIndex];
+                    return !name.StartsWith("utm_", StringComparison.Ordinal);
+                });
+
+            builder.Query = string.Join("&", retainedParameters);
+        }
+
+        return builder.Uri.AbsoluteUri;
+    }
+}
