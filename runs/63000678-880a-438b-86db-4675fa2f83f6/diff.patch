@@ -0,0 +1,16 @@
+using Xunit;
+using UrlShortener.Application.Links;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizerTests
+{
+    [Theory]
+    [InlineData("HTTP://EXAMPLE.COM:80/Keep?utm_source=a&foo=bar&utm_medium=b#Frag", "http://example.com/Keep?foo=bar#Frag")]
+    [InlineData("HTTPS://EXAMPLE.COM:443/a?UTM_source=x&utm_source=y&keep=1", "https://example.com/a?UTM_source=x&keep=1")]
+    [InlineData("http://EXAMPLE.com:8080/a?utm_source=x&keep=1", "http://example.com:8080/a?keep=1")]
+    public void Normalize_applies_requested_changes_and_preserves_other_components(string input, string expected)
+    {
+        Assert.Equal(expected, UrlNormalizer.Normalize(input));
+    }
+}
