+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizationTests
+{
+    private sealed class Clock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class Generator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private sealed class Store : ILinkCreationRepository, IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public ShortLink? SavedLink { get; private set; }
+        public string? SavedRequestHash { get; private set; }
+        public CreationStatus CreationStatus { get; init; } = CreationStatus.Created;
+        public int CreateCalls { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            CreateCalls++;
+            SavedLink = link;
+            SavedRequestHash = requestHash;
+            return Task.FromResult(new CreationResult(CreationStatus, CreationStatus == CreationStatus.Created ? link : null));
+        }
+
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken ct = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult(false);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private static LinkService CreateService(Store store) =>
+        new(new CreateLinkValidator(), store, store, store, store, new Generator(), new Clock());
+
+    [Fact]
+    public async Task CreateNormalizesSchemeHostDefaultPortAndUtmParameters()
+    {
+        var store = new Store();
+        var request = new CreateLinkRequest(
+            "HTTP://ExAmPlE.com:80/PathCase?keep=One&utm_source=campaign&UTM_medium=email&keep=Two#Section");
+
+        var link = await CreateService(store).CreateAsync(request, null, ["localhost"]);
+
+        Assert.Equal("http://example.com/PathCase?keep=One&keep=Two#Section", link.LongUrl);
+        Assert.Equal(link.LongUrl, Assert.IsType<ShortLink>(store.SavedLink).LongUrl);
+        Assert.Equal(1, store.CreateCalls);
+    }
+
+    [Fact]
+    public async Task CreateRemovesHttpsDefaultPortAndPreservesPathQueryAndFragment()
+    {
+        var store = new Store();
+        var request = new CreateLinkRequest(
+            "HTTPS://ExAmPlE.com:443/MixedCase?q=a%2Fb&utm_id=123#PartTwo");
+
+        var link = await CreateService(store).CreateAsync(request, null, ["localhost"]);
+
+        Assert.Equal("https://example.com/MixedCase?q=a%2Fb#PartTwo", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateRetainsNonDefaultPortAndUnrelatedQueryParameters()
+    {
+        var store = new Store();
+        var request = new CreateLinkRequest(
+            "HTTPS://ExAmPlE.com:8443/MixedCase?first=1&utm_campaign=spring&second=two#Anchor");
+
+        var link = await CreateService(store).CreateAsync(request, null, ["localhost"]);
+
+        Assert.Equal("https://example.com:8443/MixedCase?first=1&second=two#Anchor", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateKeepsIdempotencyHashBasedOnOriginalRequest()
+    {
+        var store = new Store();
+        var request = new CreateLinkRequest("HTTP://ExAmPlE.com:80/path?utm_source=test&keep=value");
+        var expectedHash = Convert.ToHexString(
+            SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(request))));
+
+        await CreateService(store).CreateAsync(request, "test-key", ["localhost"]);
+
+        Assert.Equal(expectedHash, store.SavedRequestHash);
+        Assert.Equal("http://example.com/path?keep=value", Assert.IsType<ShortLink>(store.SavedLink).LongUrl);
+    }
+
+    [Fact]
+    public async Task InvalidUrlDoesNotPersist()
+    {
+        var store = new Store();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(store).CreateAsync(new CreateLinkRequest("javascript:alert(1)"), null, ["localhost"]));
+
+        Assert.Equal(0, store.CreateCalls);
+    }
+
+    [Fact]
+    public async Task OwnHostDestinationDoesNotPersist()
+    {
+        var store = new Store();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(store).CreateAsync(new CreateLinkRequest("http://localhost/path"), null, ["localhost"]));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Equal(0, store.CreateCalls);
+    }
+
+    [Fact]
+    public async Task IdempotencyKeyConflictReturnsConflictAndDoesNotCreateLink()
+    {
+        var store = new Store { CreationStatus = CreationStatus.KeyConflict };
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(store).CreateAsync(new CreateLinkRequest("https://example.com/path"), "test-key", ["localhost"]));
+
+        Assert.Equal(409, exception.StatusCode);
+        Assert.Equal(1, store.CreateCalls);
+    }
+}
