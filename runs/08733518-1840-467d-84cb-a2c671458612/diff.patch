@@ -0,0 +1,105 @@
+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Applies the narrowly scoped URL normalization used when a new link is created.
+/// </summary>
+public static class UrlNormalizer
+{
+    private static readonly char[] AuthorityTerminators = ['/', '?', '#'];
+
+    public static string Normalize(string longUrl)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(longUrl);
+
+        var uri = new Uri(longUrl, UriKind.Absolute);
+        var schemeSeparator = longUrl.IndexOf("://", StringComparison.Ordinal);
+        if (schemeSeparator < 0)
+        {
+            return longUrl;
+        }
+
+        var authorityStart = schemeSeparator + 3;
+        var authorityEnd = longUrl.IndexOfAny(AuthorityTerminators, authorityStart);
+        if (authorityEnd < 0)
+        {
+            authorityEnd = longUrl.Length;
+        }
+
+        var authority = longUrl[authorityStart..authorityEnd];
+        var normalizedAuthority = NormalizeAuthority(authority, uri);
+
+        var fragmentIndex = longUrl.IndexOf('#');
+        var queryIndex = longUrl.IndexOf('?');
+        if (queryIndex >= 0 && fragmentIndex >= 0 && queryIndex > fragmentIndex)
+        {
+            queryIndex = -1;
+        }
+
+        var suffixStart = queryIndex >= 0
+            ? queryIndex
+            : fragmentIndex >= 0 ? fragmentIndex : longUrl.Length;
+
+        var normalizedPrefix = string.Concat(
+            longUrl[..schemeSeparator].ToLowerInvariant(),
+            longUrl[schemeSeparator..authorityStart],
+            normalizedAuthority,
+            longUrl[authorityEnd..suffixStart]);
+
+        if (queryIndex < 0)
+        {
+            return string.Concat(normalizedPrefix, longUrl[suffixStart..]);
+        }
+
+        var queryEnd = fragmentIndex >= 0 ? fragmentIndex : longUrl.Length;
+        var query = longUrl[(queryIndex + 1)..queryEnd];
+        var retainedParameters = query.Split('&', StringSplitOptions.None)
+            .Where(parameter => !IsUtmParameter(parameter))
+            .ToArray();
+
+        var normalizedQuery = retainedParameters.Length == 0
+            ? string.Empty
+            : "?" + string.Join('&', retainedParameters);
+
+        return string.Concat(normalizedPrefix, normalizedQuery, longUrl[queryEnd..]);
+    }
+
+    private static string NormalizeAuthority(string authority, Uri uri)
+    {
+        var userInfoEnd = authority.LastIndexOf('@');
+        var hostPortStart = userInfoEnd + 1;
+        var hostPort = authority[hostPortStart..];
+
+        int hostEnd;
+        if (hostPort.StartsWith("[", StringComparison.Ordinal))
+        {
+            var closingBracket = hostPort.IndexOf(']');
+            hostEnd = closingBracket >= 0 ? closingBracket + 1 : hostPort.Length;
+        }
+        else
+        {
+            var portSeparator = hostPort.LastIndexOf(':');
+            hostEnd = portSeparator >= 0 ? portSeparator : hostPort.Length;
+        }
+
+        var host = hostPort[..hostEnd].ToLowerInvariant();
+        var port = hostPort[hostEnd..];
+        var defaultPort = uri.Scheme.Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
+            ? 80
+            : uri.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) ? 443 : -1;
+
+        if (defaultPort >= 0 && port.StartsWith(":", StringComparison.Ordinal) && uri.Port == defaultPort)
+        {
+            port = string.Empty;
+        }
+
+        return string.Concat(authority[..hostPortStart], host, port);
+    }
+
+    private static bool IsUtmParameter(string parameter)
+    {
+        var equalsIndex = parameter.IndexOf('=');
+        var name = equalsIndex >= 0 ? parameter[..equalsIndex] : parameter;
+        var decodedName = Uri.UnescapeDataString(name);
+        return decodedName.StartsWith("utm_", StringComparison.OrdinalIgnoreCase);
+    }
+}
