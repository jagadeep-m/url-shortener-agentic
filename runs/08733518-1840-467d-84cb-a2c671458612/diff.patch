+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizationAcceptanceTests
+{
+    private sealed class FixedClock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class FixedGenerator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private sealed class CapturingRepository : ILinkCreationRepository, IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public ShortLink? PersistedLink { get; private set; }
+        public string? PersistedRequestHash { get; private set; }
+        public int CreateCalls { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            CreateCalls++;
+            PersistedLink = link;
+            PersistedRequestHash = requestHash;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private static LinkService CreateService(CapturingRepository repository) =>
+        new(new CreateLinkValidator(), repository, repository, repository, repository, new FixedGenerator(), new FixedClock());
+
+    [Fact]
+    public void NormalizeLowercasesSchemeAndHostRemovesHttpDefaultPortAndUtmParameters()
+    {
+        var actual = UrlNormalizer.Normalize(
+            "HTTP://ExAmPlE.com:80/PathCase?keep=One&utm_source=campaign&UTM_medium=email&keep=Two#Section");
+
+        Assert.Equal("http://example.com/PathCase?keep=One&keep=Two#Section", actual);
+    }
+
+    [Fact]
+    public void NormalizeRemovesHttpsDefaultPortAndEncodedUtmNameButPreservesEscapingAndFragment()
+    {
+        var actual = UrlNormalizer.Normalize(
+            "HTTPS://ExAmPlE.com:443/MixedCase?q=a%2Fb&utm%5Fsource=campaign#PartTwo");
+
+        Assert.Equal("https://example.com/MixedCase?q=a%2Fb#PartTwo", actual);
+    }
+
+    [Fact]
+    public void NormalizeRetainsNonDefaultPortAndUnrelatedDuplicateQueryParameters()
+    {
+        var actual = UrlNormalizer.Normalize(
+            "HTTPS://ExAmPlE.com:8443/MixedCase?item=One&utm_campaign=spring&item=Two#Anchor");
+
+        Assert.Equal("https://example.com:8443/MixedCase?item=One&item=Two#Anchor", actual);
+    }
+
+    [Fact]
+    public async Task CreatePersistsNormalizedDestinationAndHashesOriginalRequest()
+    {
+        var repository = new CapturingRepository();
+        var request = new CreateLinkRequest(
+            "HTTP://ExAmPlE.com:80/PathCase?keep=value&utm_source=campaign#Section");
+        var expectedHash = Convert.ToHexString(
+            SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(request))));
+
+        var result = await CreateService(repository).CreateAsync(request, "acceptance-key", ["localhost"]);
+
+        Assert.Equal("http://example.com/PathCase?keep=value#Section", result.LongUrl);
+        Assert.Equal(result.LongUrl, Assert.IsType<ShortLink>(repository.PersistedLink).LongUrl);
+        Assert.Equal(expectedHash, repository.PersistedRequestHash);
+        Assert.Equal(1, repository.CreateCalls);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationIsRejectedBeforePersistence()
+    {
+        var repository = new CapturingRepository();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(repository).CreateAsync(new CreateLinkRequest("javascript:alert(1)"), null, ["localhost"]));
+
+        Assert.Equal(0, repository.CreateCalls);
+        Assert.Null(repository.PersistedLink);
+    }
+}
