+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationPersistenceTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreationPersistsNormalizedUrlAndUsesItInResponseDetailsAndRedirect()
+    {
+        using var client = factory.Client();
+        const string expectedUrl = "http://example.com/PathCase?keep=One&keep=Two#Section";
+        var alias = "norm-" + Guid.NewGuid().ToString("N")[..12];
+        var request = new CreateLinkRequest(
+            "HTTP://ExAmPlE.com:80/PathCase?keep=One&utm_source=campaign&UTM_medium=email&keep=Two#Section",
+            alias);
+
+        using var createResponse = await client.PostAsJsonAsync("/api/v1/links", request);
+
+        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);
+        var responseLink = Assert.IsType<LinkResponse>(await createResponse.Content.ReadFromJsonAsync<LinkResponse>());
+        Assert.Equal(expectedUrl, responseLink.LongUrl);
+
+        await using (var scope = factory.Services.CreateAsyncScope())
+        {
+            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+            var persistedLink = await db.ShortLinks.AsNoTracking().SingleAsync(link => link.Code == alias);
+            Assert.Equal(expectedUrl, persistedLink.LongUrl);
+        }
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{alias}");
+        Assert.Equal(expectedUrl, Assert.IsType<LinkDetails>(details).LongUrl);
+
+        using var redirectResponse = await client.GetAsync($"/{alias}");
+        Assert.Equal(HttpStatusCode.Found, redirectResponse.StatusCode);
+        Assert.Equal(expectedUrl, redirectResponse.Headers.Location!.OriginalString);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsProblemDetailsAndDoesNotCreateLink()
+    {
+        using var client = factory.Client();
+        var alias = "reject-" + Guid.NewGuid().ToString("N")[..12];
+
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest("javascript:alert(1)", alias));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        Assert.False(await db.ShortLinks.AnyAsync(link => link.Code == alias));
+    }
+}
