+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationTests : IClassFixture<ApiFactory>
+{
+    private readonly ApiFactory factory;
+
+    public UrlNormalizationTests(ApiFactory factory)
+    {
+        this.factory = factory;
+    }
+
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.CoM:80/Path?Keep=a%2Fb&utm_source=ad&MiXeD=one+two&UTM_campaign=summer#Frag",
+        "http://example.com/Path?Keep=a%2Fb&MiXeD=one+two#Frag")]
+    [InlineData(
+        "HTTPS://ExAmPlE.CoM:443/secure?first=1&UtM_Medium=email&second=x%20y",
+        "https://example.com/secure?first=1&second=x%20y")]
+    [InlineData(
+        "HTTP://ExAmPlE.CoM:8080/custom?utm_source=ad&keep=value",
+        "http://example.com:8080/custom?keep=value")]
+    [InlineData(
+        "https://ExAmPlE.CoM/path?utm_source=ad&UTM_medium=email",
+        "https://example.com/path")]
+    public async Task CreateReturnsAndPersistsNormalizedDestination(string inputUrl, string expectedUrl)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(inputUrl));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal("/api/v1/links/" + (await response.Content.ReadFromJsonAsync<LinkResponse>())!.Code,
+            response.Headers.Location!.OriginalString);
+
+        var created = (await response.Content.ReadFromJsonAsync<LinkResponse>())!;
+        Assert.Equal(expectedUrl, created.LongUrl);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{created.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(expectedUrl, details.LongUrl);
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var savedUrl = await db.ShortLinks.Where(link => link.Code == created.Code)
+            .Select(link => link.LongUrl).SingleAsync();
+        Assert.Equal(expectedUrl, savedUrl);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsProblemDetailsAndIsNotSaved()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links",
+            new CreateLinkRequest("ftp://example.com/path?utm_source=ad"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        Assert.Equal(0, await db.ShortLinks.CountAsync());
+    }
+}
