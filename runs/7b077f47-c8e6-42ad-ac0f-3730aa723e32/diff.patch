@@ -0,0 +1,58 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateReadAndRedirectUseNormalizedDestination()
+    {
+        using var client = factory.Client();
+        const string input = "HTTPS://ExAmPlE.COM:443/PathCase?first=1&utm_source=newsletter&second=%2f&UTM_campaign=spring#Section";
+        const string expected = "https://example.com/PathCase?first=1&second=%2f#Section";
+
+        using var created = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(input));
+
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var createdLink = await created.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(createdLink);
+        Assert.Equal(expected, createdLink.LongUrl);
+        Assert.Equal($"/api/v1/links/{createdLink.Code}", created.Headers.Location!.OriginalString);
+
+        using var detailsResponse = await client.GetAsync($"/api/v1/links/{createdLink.Code}");
+        Assert.Equal(HttpStatusCode.OK, detailsResponse.StatusCode);
+        var details = await detailsResponse.Content.ReadFromJsonAsync<LinkDetails>();
+        Assert.NotNull(details);
+        Assert.Equal(expected, details.LongUrl);
+        Assert.Equal(createdLink.Code, details.Code);
+
+        using var redirect = await client.GetAsync($"/{createdLink.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.Equal(expected, redirect.Headers.Location!.OriginalString);
+    }
+
+    [Fact]
+    public async Task RejectedOwnHostUrlReturnsProblemAndIsNotPersisted()
+    {
+        using var client = factory.Client();
+        var target = $"http://localhost/{Guid.NewGuid():N}?utm_source=must-not-save";
+
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(target));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        Assert.Equal(0, await db.ShortLinks.CountAsync(link => link.LongUrl == target));
+    }
+}
