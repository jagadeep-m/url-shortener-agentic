+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationEncodedApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task EncodedUtmNamesAreRemovedFromCreatedSavedAndRedirectedDestination()
+    {
+        using var client = factory.Client();
+        const string input = "HTTPS://ExAmPlE.COM:443/PathCase?keep=%2f&%75tm_source=mail&UTM%5Fcampaign=spring&x_utm_source=retain#Section";
+        const string expected = "https://example.com/PathCase?keep=%2f&x_utm_source=retain#Section";
+
+        using var createResponse = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(input));
+
+        Assert.Equal(HttpStatusCode.Created, createResponse.StatusCode);
+        var createdLink = await createResponse.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(createdLink);
+        Assert.Equal(expected, createdLink.LongUrl);
+
+        using var detailsResponse = await client.GetAsync($"/api/v1/links/{createdLink.Code}");
+        Assert.Equal(HttpStatusCode.OK, detailsResponse.StatusCode);
+        var details = await detailsResponse.Content.ReadFromJsonAsync<LinkDetails>();
+        Assert.NotNull(details);
+        Assert.Equal(expected, details.LongUrl);
+
+        using var redirectResponse = await client.GetAsync($"/{createdLink.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirectResponse.StatusCode);
+        Assert.Equal(expected, redirectResponse.Headers.Location!.OriginalString);
+    }
+}
