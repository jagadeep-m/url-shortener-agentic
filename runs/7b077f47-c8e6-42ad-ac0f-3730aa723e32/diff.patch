+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Normalizes an absolute HTTP(S) URL's scheme and host to lowercase, removes the scheme's
+/// default port, and removes query parameters whose decoded names begin with <c>utm_</c>
+/// (case-insensitively). For example,
+/// <c>HTTPS://Example.COM:443/Path?keep=%2f&amp;utm%5Fsource=news#Section</c> becomes
+/// <c>https://example.com/Path?keep=%2f#Section</c>. Retained parameters, path casing, and
+/// fragments are preserved as supplied.
+/// </summary>
+public static class UrlNormalizer
+{
+    public static string Normalize(string url)
+    {
+        ArgumentNullException.ThrowIfNull(url);
+
+        var schemeEnd = url.IndexOf(':');
+        if (schemeEnd <= 0 || !url.AsSpan(schemeEnd + 1).StartsWith("//", StringComparison.Ordinal))
+            return url;
+
+        var scheme = url[..schemeEnd].ToLowerInvariant();
+        var authorityStart = schemeEnd + 3;
+        var authorityEnd = authorityStart;
+        while (authorityEnd < url.Length && url[authorityEnd] is not '/' and not '?' and not '#')
+            authorityEnd++;
+
+        var authority = url[authorityStart..authorityEnd];
+        var userInfoEnd = authority.LastIndexOf('@');
+        var userInfo = userInfoEnd >= 0 ? authority[..(userInfoEnd + 1)] : string.Empty;
+        var hostAndPort = authority[(userInfoEnd + 1)..];
+
+        var hostEnd = hostAndPort.Length;
+        var portStart = -1;
+        if (hostAndPort.StartsWith("[", StringComparison.Ordinal))
+        {
+            var closingBracket = hostAndPort.IndexOf(']');
+            if (closingBracket >= 0)
+            {
+                hostEnd = closingBracket + 1;
+                if (hostEnd < hostAndPort.Length && hostAndPort[hostEnd] == ':')
+                    portStart = hostEnd;
+            }
+        }
+        else
+        {
+            var colon = hostAndPort.LastIndexOf(':');
+            if (colon >= 0 && hostAndPort.IndexOf(':') == colon)
+            {
+                hostEnd = colon;
+                portStart = colon;
+            }
+        }
+
+        var host = hostAndPort[..hostEnd].ToLowerInvariant();
+        var port = portStart >= 0 ? hostAndPort[(portStart + 1)..] : string.Empty;
+        var removePort = portStart >= 0
+            && int.TryParse(port, System.Globalization.NumberStyles.None,
+                System.Globalization.CultureInfo.InvariantCulture, out var portNumber)
+            && ((scheme == "http" && portNumber == 80) || (scheme == "https" && portNumber == 443));
+        var normalizedAuthority = userInfo + host
+            + (portStart >= 0 && !removePort ? hostAndPort[portStart..] : string.Empty);
+
+        var fragmentIndex = url.IndexOf('#', authorityEnd);
+        var queryIndex = url.IndexOf('?', authorityEnd);
+        if (queryIndex < 0 || (fragmentIndex >= 0 && queryIndex > fragmentIndex))
+            return scheme + "://" + normalizedAuthority + url[authorityEnd..];
+
+        var queryEnd = fragmentIndex >= 0 ? fragmentIndex : url.Length;
+        var query = url[(queryIndex + 1)..queryEnd];
+        var retainedParameters = query.Split('&')
+            .Where(parameter =>
+            {
+                var equalsIndex = parameter.IndexOf('=');
+                var name = equalsIndex >= 0 ? parameter[..equalsIndex] : parameter;
+                var decodedName = Uri.UnescapeDataString(name);
+                return !decodedName.StartsWith("utm_", StringComparison.OrdinalIgnoreCase);
+            })
+            .ToArray();
+
+        var result = scheme + "://" + normalizedAuthority + url[authorityEnd..queryIndex];
+        if (retainedParameters.Length > 0)
+            result += "?" + string.Join("&", retainedParameters);
+        if (fragmentIndex >= 0)
+            result += url[fragmentIndex..];
+        return result;
+    }
+}
diff --git a/tests/UrlShortener.IntegrationTests/UrlNormalizationApiTests.cs b/tests/UrlShortener.IntegrationTests/UrlNormalizationApiTests.cs
