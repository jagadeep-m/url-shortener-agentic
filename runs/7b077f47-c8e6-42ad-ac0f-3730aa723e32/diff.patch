+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizerEncodedParameterTests
+{
+    [Theory]
+    [InlineData(
+        "HTTPS://ExAmPlE.COM:443/Path?%75tm_source=mail&keep=%2f&UTM%5Fmedium=spring&x_utm_source=retain#Section",
+        "https://example.com/Path?keep=%2f&x_utm_source=retain#Section")]
+    [InlineData(
+        "http://ExAmPlE.com:80/path?u%74m_campaign=summer&value=utm_source&utm%5fcontent=ad",
+        "http://example.com/path?value=utm_source")]
+    public void NormalizeStripsEncodedUtmNamesAndPreservesOtherComponents(string input, string expected)
+    {
+        var normalized = UrlNormalizer.Normalize(input);
+
+        Assert.Equal(expected, normalized);
+    }
+
+    [Fact]
+    public void NormalizeRejectsNullInput()
+    {
+        Assert.Throws<ArgumentNullException>(() => UrlNormalizer.Normalize(null!));
+    }
+}
