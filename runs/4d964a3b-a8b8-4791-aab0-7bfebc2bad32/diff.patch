+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizerTests
+{
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.Com:80/a/b?keep=a%2Fb&uTm_source=one&notutm_term=x&utmx=y#Section",
+        "http://example.com/a/b?keep=a%2Fb&notutm_term=x&utmx=y#Section")]
+    [InlineData(
+        "HTTPS://ExAMPLE.Com:443/path?UtM_source=x&utm_campaign=y#frag",
+        "https://example.com/path#frag")]
+    [InlineData(
+        "HtTp://ExAMPLE.Com:8080/path?utm_source=x&keep=a%2Fb#Frag",
+        "http://example.com:8080/path?keep=a%2Fb#Frag")]
+    [InlineData(
+        "HTTPS://ExAMPLE.Com/path?keep=one&utm_source=two&keep=three",
+        "https://example.com/path?keep=one&keep=three")]
+    [InlineData(
+        "https://example.com/path?utm_source=one&utm_campaign=two#fragment",
+        "https://example.com/path#fragment")]
+    [InlineData(
+        "https://example.com/path?utm_source=one&&#fragment",
+        "https://example.com/path#fragment")]
+    [InlineData(
+        "https://example.com/path?notutm_source=one&utmx=two",
+        "https://example.com/path?notutm_source=one&utmx=two")]
+    [InlineData(
+        "https://example.com/path#fragment",
+        "https://example.com/path#fragment")]
+    public void NormalizeAppliesOnlyRequestedUrlTransformations(string submittedUrl, string expectedUrl)
+    {
+        Assert.Equal(expectedUrl, UrlNormalizer.Normalize(submittedUrl));
+    }
+
+    [Fact]
+    public void NormalizeRejectsNullInput()
+    {
+        Assert.Throws<ArgumentNullException>(() => UrlNormalizer.Normalize(null!));
+    }
+
+    [Theory]
+    [InlineData("/relative/path")]
+    [InlineData("ftp://example.com/file")]
+    [InlineData("not a URL")]
+    [InlineData("http://")]
+    public void NormalizeRejectsInvalidOrUnsupportedUrls(string submittedUrl)
+    {
+        Assert.Throws<ArgumentException>(() => UrlNormalizer.Normalize(submittedUrl));
+    }
+}
