+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.Com:80/a/b?keep=a%2Fb&uTm_source=one&notutm_term=x&utmx=y&UTM_medium=email#Section",
+        "http://example.com/a/b?keep=a%2Fb&notutm_term=x&utmx=y#Section")]
+    [InlineData(
+        "HTTPS://ExAMPLE.Com:443/path?UtM_source=x&utm_campaign=y#frag",
+        "https://example.com/path#frag")]
+    [InlineData(
+        "HtTp://ExAMPLE.Com:8080/path?utm_source=x&keep=a%2Fb#Frag",
+        "http://example.com:8080/path?keep=a%2Fb#Frag")]
+    public async Task CreateLinkReturnsAndRedirectsToNormalizedDestination(string submittedUrl, string expectedUrl)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(submittedUrl));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(created);
+        Assert.Equal(expectedUrl, created.LongUrl);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{created.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(expectedUrl, details.LongUrl);
+
+        using var redirect = await client.GetAsync($"/{created.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.NotNull(redirect.Headers.Location);
+        Assert.Equal(expectedUrl, redirect.Headers.Location.OriginalString);
+    }
+
+    [Theory]
+    [InlineData("javascript:alert(1)")]
+    [InlineData("/relative/path")]
+    public async Task InvalidDestinationReturnsBadRequestProblemDetails(string submittedUrl)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(submittedUrl));
+
+        await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+    }
+
+    [Fact]
+    public async Task SelfHostedDestinationReturnsBadRequestProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest("http://localhost/self-hosted"));
+
+        await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+    }
+
+    private static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode expectedStatus)
+    {
+        Assert.Equal(expectedStatus, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)expectedStatus, body.GetProperty("status").GetInt32());
+    }
+}
