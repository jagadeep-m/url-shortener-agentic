+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using UrlShortener.Application.Links;
+using UrlShortener.Infrastructure;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationPersistenceApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateLinkReturnsAndPersistsNormalizedDestination()
+    {
+        using var client = factory.Client();
+        const string submittedUrl = "HTTPS://ExAMPLE.Com:443/path?keep=a%2Fb&UtM_Source=campaign#section";
+        const string expectedUrl = "https://example.com/path?keep=a%2Fb#section";
+
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest(submittedUrl));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(created);
+        Assert.Equal(expectedUrl, created.LongUrl);
+
+        await using var scope = factory.Services.CreateAsyncScope();
+        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
+        var saved = await db.ShortLinks.AsNoTracking()
+            .SingleAsync(link => link.Code == created.Code);
+        Assert.Equal(expectedUrl, saved.LongUrl);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest("javascript:alert(1)"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+
+        var bodyText = await response.Content.ReadAsStringAsync();
+        using var body = JsonDocument.Parse(bodyText);
+        Assert.Equal((int)HttpStatusCode.BadRequest, body.RootElement.GetProperty("status").GetInt32());
+    }
+}
