diff --git a/src/UrlShortener.Application/Links/UrlNormalizer.cs b/src/UrlShortener.Application/Links/UrlNormalizer.cs
new file mode 100644
index 0000000..3480e78
--- /dev/null
+++ b/src/UrlShortener.Application/Links/UrlNormalizer.cs
@@ -0,0 +1,98 @@
+using System.Globalization;
+
+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Applies the URL transformations required when saving a newly created link,
+/// while retaining the original spelling of components that are not changed.
+/// </summary>
+public static class UrlNormalizer
+{
+    public static string Normalize(string longUrl)
+    {
+        ArgumentNullException.ThrowIfNull(longUrl);
+
+        var schemeSeparator = longUrl.IndexOf("://", StringComparison.Ordinal);
+        if (schemeSeparator <= 0 || !Uri.TryCreate(longUrl, UriKind.Absolute, out var uri))
+            throw new ArgumentException("An absolute HTTP(S) URL is required.", nameof(longUrl));
+
+        var scheme = longUrl[..schemeSeparator];
+        if (!scheme.Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
+            && !scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("An absolute HTTP(S) URL is required.", nameof(longUrl));
+
+        var authorityStart = schemeSeparator + 3;
+        var authorityEnd = longUrl.IndexOfAny(new[] { '/', '?', '#' }, authorityStart);
+        if (authorityEnd < 0)
+            authorityEnd = longUrl.Length;
+
+        var authority = longUrl[authorityStart..authorityEnd];
+        var hostStart = authority.LastIndexOf('@') + 1;
+        var hostEnd = authority.Length;
+        var portSeparator = -1;
+
+        if (hostStart < authority.Length && authority[hostStart] == '[')
+        {
+            var closingBracket = authority.IndexOf(']', hostStart);
+            if (closingBracket < 0)
+                throw new ArgumentException("The URL host is invalid.", nameof(longUrl));
+
+            hostEnd = closingBracket + 1;
+            if (hostEnd < authority.Length && authority[hostEnd] == ':')
+                portSeparator = hostEnd;
+        }
+        else
+        {
+            var colon = authority.LastIndexOf(':');
+            if (colon >= hostStart)
+            {
+                hostEnd = colon;
+                portSeparator = colon;
+            }
+        }
+
+        var host = authority[hostStart..hostEnd].ToLowerInvariant();
+        var removeDefaultPort = false;
+        if (portSeparator >= 0)
+        {
+            var portText = authority[(portSeparator + 1)..];
+            if (int.TryParse(portText, NumberStyles.None, CultureInfo.InvariantCulture, out var port))
+            {
+                removeDefaultPort = (scheme.Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase) && port == 80)
+                    || (scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) && port == 443);
+            }
+        }
+
+        var authoritySuffix = removeDefaultPort ? string.Empty : authority[hostEnd..];
+        var normalizedAuthority = string.Concat(authority[..hostStart], host, authoritySuffix);
+        var normalized = string.Concat(scheme.ToLowerInvariant(), "://", normalizedAuthority, longUrl[authorityEnd..]);
+        return StripUtmParameters(normalized);
+    }
+
+    private static string StripUtmParameters(string url)
+    {
+        var queryStart = url.IndexOf('?');
+        if (queryStart < 0)
+            return url;
+
+        var fragmentStart = url.IndexOf('#', queryStart);
+        var queryEnd = fragmentStart < 0 ? url.Length : fragmentStart;
+        var query = url[(queryStart + 1)..queryEnd];
+        var remainingSegments = query.Split('&')
+            .Where(segment =>
+            {
+                var equals = segment.IndexOf('=');
+                var name = equals < 0 ? segment : segment[..equals];
+                return !name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase);
+            })
+            .ToArray();
+
+        // Empty segments alone do not constitute remaining query parameters.
+        if (!remainingSegments.Any(segment => segment.Length > 0))
+            return string.Concat(url[..queryStart], fragmentStart < 0 ? string.Empty : url[fragmentStart..]);
+
+        var retainedQuery = string.Join('&', remainingSegments);
+        return string.Concat(url[..queryStart], "?", retainedQuery,
+            fragmentStart < 0 ? string.Empty : url[fragmentStart..]);
+    }
+}
