+++ b/tests/UrlShortener.IntegrationTests/MaxClicksApiTests.cs
@@ -0,0 +1,129 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class MaxClicksApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task LimitedLinkRedirectsUpToItsLimitThenReturnsGoneProblemDetails()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, maxClicks: 2);
+
+        using var first = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Found, first.StatusCode);
+        Assert.Equal(link.LongUrl, first.Headers.Location!.AbsoluteUri);
+
+        using var second = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Found, second.StatusCode);
+        Assert.Equal(link.LongUrl, second.Headers.Location!.AbsoluteUri);
+
+        using var overLimit = await client.GetAsync($"/{link.Code}");
+        var problem = await AssertProblemAsync(overLimit, HttpStatusCode.Gone);
+        Assert.Equal("Gone", problem.GetProperty("title").GetString());
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(2, details.ClickCount);
+
+        var stats = await client.GetFromJsonAsync<LinkStats>($"/api/v1/links/{link.Code}/stats");
+        Assert.NotNull(stats);
+        Assert.Equal(2, stats.TotalClicks);
+    }
+
+    [Fact]
+    public async Task LinkWithLimitOfOneAllowsExactlyOneRedirect()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, maxClicks: 1);
+
+        using var first = await client.GetAsync($"/{link.Code}");
+        Assert.Equal(HttpStatusCode.Found, first.StatusCode);
+
+        using var second = await client.GetAsync($"/{link.Code}");
+        var problem = await AssertProblemAsync(second, HttpStatusCode.Gone);
+        Assert.Equal("Gone", problem.GetProperty("title").GetString());
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(1, details.ClickCount);
+    }
+
+    [Fact]
+    public async Task LinkWithoutLimitContinuesRedirectingAndRecordingClicks()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client);
+
+        for (var i = 0; i < 3; i++)
+        {
+            using var redirect = await client.GetAsync($"/{link.Code}");
+            Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+            Assert.Equal(link.LongUrl, redirect.Headers.Location!.AbsoluteUri);
+        }
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{link.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(3, details.ClickCount);
+
+        var stats = await client.GetFromJsonAsync<LinkStats>($"/api/v1/links/{link.Code}/stats");
+        Assert.NotNull(stats);
+        Assert.Equal(3, stats.TotalClicks);
+    }
+
+    [Fact]
+    public async Task CreateAcceptsMaximumAllowedLimit()
+    {
+        using var client = factory.Client();
+        var link = await CreateLinkAsync(client, maxClicks: 1_000_000);
+
+        using var redirect = await client.GetAsync($"/{link.Code}");
+
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.Equal(link.LongUrl, redirect.Headers.Location!.AbsoluteUri);
+    }
+
+    [Theory]
+    [InlineData(-1)]
+    [InlineData(0)]
+    [InlineData(1_000_001)]
+    public async Task CreateRejectsLimitOutsideAllowedRange(int maxClicks)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(
+            "https://example.com/max-clicks-invalid", MaxClicks: maxClicks));
+
+        var problem = await AssertProblemAsync(response, HttpStatusCode.BadRequest);
+        Assert.True(problem.TryGetProperty("errors", out var errors));
+        Assert.Contains(errors.EnumerateObject(), error => error.Name == "MaxClicks");
+    }
+
+    private static async Task<LinkResponse> CreateLinkAsync(HttpClient client, int? maxClicks = null)
+    {
+        var request = new CreateLinkRequest(
+            $"https://example.com/max-clicks/{Guid.NewGuid():N}",
+            MaxClicks: maxClicks);
+        using var response = await client.PostAsJsonAsync("/api/v1/links", request);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var link = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(link);
+        return link;
+    }
+
+    private static async Task<JsonElement> AssertProblemAsync(HttpResponseMessage response, HttpStatusCode expectedStatus)
+    {
+        Assert.Equal(expectedStatus, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)expectedStatus, problem.GetProperty("status").GetInt32());
+        Assert.True(problem.TryGetProperty("title", out var title));
+        Assert.False(string.IsNullOrWhiteSpace(title.GetString()));
+        return problem;
+    }
+}
