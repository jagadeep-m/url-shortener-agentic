+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class MaxClicksTests
+{
+    private static readonly DateTime Now = new(2026, 10, 17, 12, 0, 0, DateTimeKind.Utc);
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(1_000_000)]
+    public async Task ValidatorAcceptsMaxClicksAtInclusiveBoundaries(int maxClicks)
+    {
+        var validator = new CreateLinkValidator();
+
+        var result = await validator.ValidateAsync(
+            new CreateLinkRequest("https://example.com/target", MaxClicks: maxClicks));
+
+        Assert.True(result.IsValid);
+    }
+
+    [Fact]
+    public async Task ValidatorAcceptsAnOmittedMaxClicksLimit()
+    {
+        var validator = new CreateLinkValidator();
+
+        var result = await validator.ValidateAsync(new CreateLinkRequest("https://example.com/target"));
+
+        Assert.True(result.IsValid);
+    }
+
+    [Theory]
+    [InlineData(-1)]
+    [InlineData(0)]
+    [InlineData(1_000_001)]
+    public async Task ValidatorRejectsMaxClicksOutsideInclusiveBounds(int maxClicks)
+    {
+        var validator = new CreateLinkValidator();
+
+        var result = await validator.ValidateAsync(
+            new CreateLinkRequest("https://example.com/target", MaxClicks: maxClicks));
+
+        Assert.False(result.IsValid);
+        Assert.Contains(result.Errors, error => error.PropertyName == nameof(CreateLinkRequest.MaxClicks));
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(1_000_000)]
+    public void DomainStoresMaxClicksAtInclusiveBoundaries(int maxClicks)
+    {
+        var link = new ShortLink("limit-test", "https://example.com/target", Now, maxClicks: maxClicks);
+
+        Assert.Equal(maxClicks, link.MaxClicks);
+        Assert.Equal(0, link.ClickCount);
+    }
+
+    [Theory]
+    [InlineData(-1)]
+    [InlineData(0)]
+    [InlineData(1_000_001)]
+    public void DomainRejectsMaxClicksOutsideInclusiveBounds(int maxClicks)
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() =>
+            new ShortLink("limit-test", "https://example.com/target", Now, maxClicks: maxClicks));
+    }
+
+    [Theory]
+    [InlineData(ClickRecordingResult.Recorded, null)]
+    [InlineData(ClickRecordingResult.LimitReached, 410)]
+    [InlineData(ClickRecordingResult.MissingLink, 404)]
+    public async Task ServiceMapsClickRecordingResults(ClickRecordingResult result, int? expectedStatus)
+    {
+        var repository = new ResultRepository(result);
+        var service = CreateService(repository);
+        var click = new ClickEvent(1, Now);
+
+        if (expectedStatus is null)
+        {
+            await service.RecordClickAsync(click);
+        }
+        else
+        {
+            var exception = await Assert.ThrowsAsync<LinkOperationException>(
+                () => service.RecordClickAsync(click));
+            Assert.Equal(expectedStatus, exception.StatusCode);
+        }
+
+        Assert.Same(click, repository.RecordedClick);
+    }
+
+    [Fact]
+    public async Task ServiceReportsMissingClickRepositoryConfiguration()
+    {
+        var service = new LinkService(
+            null!, null!, null!, null!, null!, null!, TimeProvider.System);
+
+        await Assert.ThrowsAsync<InvalidOperationException>(
+            () => service.RecordClickAsync(new ClickEvent(1, Now)));
+    }
+
+    private static LinkService CreateService(IClickEventRepository repository) =>
+        new(null!, null!, null!, null!, null!, null!, TimeProvider.System, repository);
+
+    private sealed class ResultRepository(ClickRecordingResult result) : IClickEventRepository
+    {
+        public ClickEvent? RecordedClick { get; private set; }
+
+        public Task<bool> RecordAsync(ClickEvent clickEvent, CancellationToken cancellationToken = default)
+        {
+            RecordedClick = clickEvent;
+            return Task.FromResult(result == ClickRecordingResult.Recorded);
+        }
+
+        public Task<ClickRecordingResult> RecordWithLimitAsync(
+            ClickEvent clickEvent,
+            CancellationToken cancellationToken = default)
+        {
+            RecordedClick = clickEvent;
+            return Task.FromResult(result);
+        }
+
+        public Task<IReadOnlyList<ClickEvent>> GetByShortLinkIdAsync(
+            long shortLinkId,
+            CancellationToken cancellationToken = default) =>
+            Task.FromResult<IReadOnlyList<ClickEvent>>(Array.Empty<ClickEvent>());
+    }
+}
