+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Normalizes valid hierarchical destination URLs without rebuilding their path,
+/// query values, or fragment through <see cref="UriBuilder"/>.
+/// </summary>
+public static class UrlNormalizer
+{
+    /// <summary>
+    /// Lowercases the URL scheme and host, removes HTTP and HTTPS default ports,
+    /// and removes query parameters whose names begin with <c>utm_</c>.
+    /// Other URL components and the order and representation of retained query
+    /// parameters are preserved.
+    /// </summary>
+    public static string Normalize(string url)
+    {
+        ArgumentNullException.ThrowIfNull(url);
+
+        var schemeSeparator = url.IndexOf("://", StringComparison.Ordinal);
+        if (schemeSeparator <= 0)
+        {
+            return url;
+        }
+
+        var scheme = url[..schemeSeparator];
+        var authorityStart = schemeSeparator + 3;
+        var authorityEnd = FindFirst(url, authorityStart, '/', '?', '#');
+        if (authorityEnd < 0)
+        {
+            authorityEnd = url.Length;
+        }
+
+        var authority = url[authorityStart..authorityEnd];
+        if (authority.Length == 0)
+        {
+            return url;
+        }
+
+        var normalizedAuthority = NormalizeAuthority(authority, scheme);
+        var normalizedSuffix = RemoveTrackingParameters(url[authorityEnd..]);
+
+        return string.Concat(
+            scheme.ToLowerInvariant(),
+            "://",
+            normalizedAuthority,
+            normalizedSuffix);
+    }
+
+    private static string NormalizeAuthority(string authority, string scheme)
+    {
+        var userInfoEnd = authority.LastIndexOf('@');
+        var hostStart = userInfoEnd + 1;
+        var hostAndPort = authority[hostStart..];
+        if (hostAndPort.Length == 0)
+        {
+            return authority;
+        }
+
+        int hostEnd;
+        if (hostAndPort[0] == '[')
+        {
+            var closingBracket = hostAndPort.IndexOf(']');
+            if (closingBracket < 0)
+            {
+                return authority;
+            }
+
+            hostEnd = closingBracket + 1;
+        }
+        else
+        {
+            var colon = hostAndPort.LastIndexOf(':');
+            hostEnd = colon >= 0 && hostAndPort.IndexOf(':') == colon
+                ? colon
+                : hostAndPort.Length;
+        }
+
+        var host = hostAndPort[..hostEnd];
+        var suffix = hostAndPort[hostEnd..];
+        var normalizedSuffix = IsDefaultPort(suffix, scheme) ? string.Empty : suffix;
+
+        return string.Concat(
+            authority[..hostStart],
+            host.ToLowerInvariant(),
+            normalizedSuffix);
+    }
+
+    private static bool IsDefaultPort(string suffix, string scheme)
+    {
+        if (suffix.Length < 2 || suffix[0] != ':')
+        {
+            return false;
+        }
+
+        return (scheme.Equals("http", StringComparison.OrdinalIgnoreCase)
+                && suffix.AsSpan(1).SequenceEqual("80"))
+            || (scheme.Equals("https", StringComparison.OrdinalIgnoreCase)
+                && suffix.AsSpan(1).SequenceEqual("443"));
+    }
+
+    private static string RemoveTrackingParameters(string suffix)
+    {
+        var fragmentStart = suffix.IndexOf('#');
+        var queryEnd = fragmentStart >= 0 ? fragmentStart : suffix.Length;
+        var queryStart = suffix.IndexOf('?');
+        if (queryStart < 0 || queryStart > queryEnd)
+        {
+            return suffix;
+        }
+
+        var query = suffix[(queryStart + 1)..queryEnd];
+        var fragment = suffix[queryEnd..];
+        var parameters = query.Split('&');
+        var retained = new List<string>(parameters.Length);
+        foreach (var parameter in parameters)
+        {
+            var equals = parameter.IndexOf('=');
+            var name = equals >= 0 ? parameter[..equals] : parameter;
+            if (!name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase))
+            {
+                retained.Add(parameter);
+            }
+        }
+
+        if (retained.Count == parameters.Length)
+        {
+            return suffix;
+        }
+
+        if (retained.Count == 0)
+        {
+            return string.Concat(suffix[..queryStart], fragment);
+        }
+
+        return string.Concat(
+            suffix[..queryStart],
+            "?",
+            string.Join('&', retained),
+            fragment);
+    }
+
+    private static int FindFirst(string value, int start, char first, char second, char third)
+    {
+        for (var index = start; index < value.Length; index++)
+        {
+            var character = value[index];
+            if (character == first || character == second || character == third)
+            {
+                return index;
+            }
+        }
+
+        return -1;
+    }
+}
