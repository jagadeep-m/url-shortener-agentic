+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class LinkNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateDetailsAndRedirectUseTheNormalizedDestination()
+    {
+        using var client = factory.Client();
+        const string normalizedUrl = "https://example.com/path?keep=one&other=two#section";
+        var request = new CreateLinkRequest(
+            "HTTPS://ExAmPlE.com:443/path?utm_source=newsletter&keep=one&UTM_campaign=spring&other=two#section",
+            "normalized-" + Guid.NewGuid().ToString("N")[..12]);
+
+        using var created = await client.PostAsJsonAsync("/api/v1/links", request);
+
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+        var response = await created.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(response);
+        Assert.Equal(normalizedUrl, response.LongUrl);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{response.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(normalizedUrl, details.LongUrl);
+
+        using var redirect = await client.GetAsync($"/{response.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.Equal(normalizedUrl, redirect.Headers.Location!.OriginalString);
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsProblemDetailsWithoutCreatingLink()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links", new CreateLinkRequest("not an absolute URL"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+        Assert.True(problem.TryGetProperty("type", out _));
+    }
+}
diff --git a/tests/UrlShortener.UnitTests/LinkNormalizationTests.cs b/tests/UrlShortener.UnitTests/LinkNormalizationTests.cs
