@@ -0,0 +1,175 @@
+using System.Security.Cryptography;
+using System.Text;
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LinkNormalizationTests
+{
+    private sealed class FixedClock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class FixedGenerator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private sealed class CreationRepository : ILinkCreationRepository
+    {
+        public ShortLink? SavedLink { get; private set; }
+        public int SaveCalls { get; private set; }
+        public string? SavedKey { get; private set; }
+        public string? SavedHash { get; private set; }
+        public bool ThrowOnSave { get; init; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (SavedLink is null || SavedKey != key)
+                return Task.FromResult<IdempotentLink?>(null);
+
+            return Task.FromResult<IdempotentLink?>(new IdempotentLink(SavedHash!, SavedLink));
+        }
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            SaveCalls++;
+            if (ThrowOnSave)
+                throw new InvalidOperationException("The persistence operation failed.");
+
+            SavedLink = link;
+            SavedKey = key;
+            SavedHash = requestHash;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+    }
+
+    private sealed class OtherRepositories : IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult(false);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private static LinkService CreateService(CreationRepository creation) =>
+        new(new CreateLinkValidator(), creation, new OtherRepositories(), new OtherRepositories(),
+            new OtherRepositories(), new FixedGenerator(), new FixedClock());
+
+    [Theory]
+    [InlineData("HTTP://ExAmPlE.com:80/path?utm_source=x&Keep=two#Part", "http://example.com/path?Keep=two#Part")]
+    [InlineData("HTTPS://ExAmPlE.com:443/path?Keep=one&utm_CAMPAIGN=x&keep=two#Frag", "https://example.com/path?Keep=one&keep=two#Frag")]
+    [InlineData("http://ExAmPlE.com:8080/path?utm_source=x&keep=y", "http://example.com:8080/path?keep=y")]
+    public async Task SavesLowercaseSchemeAndHostAndRemovesOnlyDefaultPortsAndUtmParameters(string input, string expected)
+    {
+        var creation = new CreationRepository();
+
+        var link = await CreateService(creation).CreateAsync(new CreateLinkRequest(input), null, ["shortener.example"]);
+
+        Assert.Equal(expected, link.LongUrl);
+        Assert.Equal(expected, Assert.IsType<ShortLink>(creation.SavedLink).LongUrl);
+        Assert.Equal(1, creation.SaveCalls);
+    }
+
+    [Fact]
+    public async Task RemovesQueryStringWhenItContainsOnlyUtmParametersAndPreservesFragment()
+    {
+        var creation = new CreationRepository();
+
+        var link = await CreateService(creation).CreateAsync(
+            new CreateLinkRequest("HTTPS://ExAmPlE.com:443/path?utm_source=newsletter&UTM_medium=email#section"),
+            null, ["shortener.example"]);
+
+        Assert.Equal("https://example.com/path#section", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task PreservesNonUtmParametersAndTheirOrderAndDoesNotRemoveSimilarNames()
+    {
+        var creation = new CreationRepository();
+
+        var link = await CreateService(creation).CreateAsync(
+            new CreateLinkRequest("http://EXAMPLE.com/path?first=1&utm_source=campaign&notutm_source=2&last=a%2Bb#details"),
+            null, ["shortener.example"]);
+
+        Assert.Equal("http://example.com/path?first=1&notutm_source=2&last=a%2Bb#details", link.LongUrl);
+    }
+
+    [Fact]
+    public async Task IdempotencyHashContinuesToUseTheOriginalRequest()
+    {
+        var creation = new CreationRepository();
+        var service = CreateService(creation);
+        const string key = "normalization-idempotency-key";
+
+        var originalRequest = new CreateLinkRequest("HTTP://Example.com:80/path?utm_source=one&keep=yes");
+        var first = await service.CreateAsync(originalRequest, key, ["shortener.example"]);
+        var firstHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(
+            System.Text.Json.JsonSerializer.Serialize(originalRequest))));
+
+        var equivalentAfterNormalization = new CreateLinkRequest("http://example.com/path?keep=yes");
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            service.CreateAsync(equivalentAfterNormalization, key, ["shortener.example"]));
+
+        Assert.Equal("http://example.com/path?keep=yes", first.LongUrl);
+        Assert.Equal(firstHash, creation.SavedHash);
+        Assert.Equal(409, exception.StatusCode);
+        Assert.Equal(1, creation.SaveCalls);
+    }
+
+    [Fact]
+    public async Task InvalidUrlFailsValidationWithoutAttemptingPersistence()
+    {
+        var creation = new CreationRepository();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(creation).CreateAsync(new CreateLinkRequest("not an absolute URL"), null, ["shortener.example"]));
+
+        Assert.Equal(0, creation.SaveCalls);
+        Assert.Null(creation.SavedLink);
+    }
+
+    [Fact]
+    public async Task OwnHostRejectionDoesNotAttemptPersistence()
+    {
+        var creation = new CreationRepository();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(creation).CreateAsync(
+                new CreateLinkRequest("https://SHORTENER.example/path?utm_source=test"), null, ["shortener.example"]));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Equal(0, creation.SaveCalls);
+        Assert.Null(creation.SavedLink);
+    }
+
+    [Fact]
+    public async Task PersistenceFailureIsPropagated()
+    {
+        var creation = new CreationRepository { ThrowOnSave = true };
+
+        var exception = await Assert.ThrowsAsync<InvalidOperationException>(() =>
+            CreateService(creation).CreateAsync(
+                new CreateLinkRequest("HTTP://Example.com:80/path?utm_source=test"), null, ["shortener.example"]));
+
+        Assert.Equal("The persistence operation failed.", exception.Message);
+        Assert.Equal(1, creation.SaveCalls);
+    }
+}
