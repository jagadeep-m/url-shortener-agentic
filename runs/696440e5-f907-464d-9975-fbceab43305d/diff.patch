+    private static string NormalizeUrl(Uri target)
+    {
+        var builder = new UriBuilder(target)
+        {
+            Scheme = target.Scheme.ToLowerInvariant(),
+            Host = target.IdnHost.ToLowerInvariant()
+        };
+
+        if ((builder.Scheme == Uri.UriSchemeHttp && target.Port == 80)
+            || (builder.Scheme == Uri.UriSchemeHttps && target.Port == 443))
+        {
+            builder.Port = -1;
+        }
+        else
+        {
+            builder.Port = target.Port;
+        }
+
+        var query = target.Query;
+        if (query.Length > 1)
+        {
+            var parameters = query[1..].Split('&');
+            var remaining = parameters
+                .Where(parameter => !Uri.UnescapeDataString(parameter.Split('=', 2)[0])
+                    .StartsWith("utm_", StringComparison.Ordinal))
+                .ToArray();
+
+            if (remaining.Any(parameter => parameter.Length > 0))
+            {
+                builder.Query = string.Join('&', remaining);
+            }
+            else
+            {
+                builder.Query = string.Empty;
+            }
+        }
+
+        return builder.Uri.AbsoluteUri;
+    }
+
     private static bool IsLoopbackHost(string host) => host.TrimEnd('.').Equals("localhost", StringComparison.OrdinalIgnoreCase)
         || (IPAddress.TryParse(host.Trim('[', ']'), out var address) && IPAddress.IsLoopback(address));
 
