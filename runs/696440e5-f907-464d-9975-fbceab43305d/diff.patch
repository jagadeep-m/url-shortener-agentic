+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateLinkReturnsAndPersistsNormalizedDestination()
+    {
+        using var client = factory.Client();
+        using var response = await PostLinkAsync(client,
+            "HTTPS://ExAmPlE.com:443/path?first=1&utm_source=newsletter&keep=a%20b&utm_medium=email#section");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        using var created = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        var code = created.RootElement.GetProperty("code").GetString();
+        const string expected = "https://example.com/path?first=1&keep=a%20b#section";
+        Assert.Equal(expected, created.RootElement.GetProperty("longUrl").GetString());
+        Assert.False(string.IsNullOrWhiteSpace(code));
+
+        using var detailsResponse = await client.GetAsync($"/api/v1/links/{code}");
+        Assert.Equal(HttpStatusCode.OK, detailsResponse.StatusCode);
+        using var details = JsonDocument.Parse(await detailsResponse.Content.ReadAsStringAsync());
+        Assert.Equal(expected, details.RootElement.GetProperty("longUrl").GetString());
+    }
+
+    [Fact]
+    public async Task InvalidDestinationReturnsValidationProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await PostLinkAsync(client, "ftp://example.com/path");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        using var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.Equal(400, problem.RootElement.GetProperty("status").GetInt32());
+        Assert.True(problem.RootElement.TryGetProperty("errors", out _));
+    }
+
+    [Fact]
+    public async Task OwnHostDestinationReturnsProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await PostLinkAsync(client, "http://localhost/path?utm_source=ignored");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        using var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.Equal(400, problem.RootElement.GetProperty("status").GetInt32());
+    }
+
+    [Fact]
+    public async Task IdempotencyKeyWithDifferentRequestReturnsConflictProblemDetails()
+    {
+        using var client = factory.Client();
+        using var firstResponse = await PostLinkAsync(client, "https://example.com/first?utm_source=remove", "normalization-conflict-key");
+        Assert.Equal(HttpStatusCode.Created, firstResponse.StatusCode);
+
+        using var conflictResponse = await PostLinkAsync(client, "https://example.com/second?utm_source=remove", "normalization-conflict-key");
+
+        Assert.Equal(HttpStatusCode.Conflict, conflictResponse.StatusCode);
+        Assert.Equal("application/problem+json", conflictResponse.Content.Headers.ContentType?.MediaType);
+        using var problem = JsonDocument.Parse(await conflictResponse.Content.ReadAsStringAsync());
+        Assert.Equal(409, problem.RootElement.GetProperty("status").GetInt32());
+    }
+
+    private static async Task<HttpResponseMessage> PostLinkAsync(HttpClient client, string longUrl, string? idempotencyKey = null)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/v1/links")
+        {
+            Content = JsonContent.Create(new { longUrl })
+        };
+        if (idempotencyKey is not null)
+        {
+            request.Headers.Add("Idempotency-Key", idempotencyKey);
+        }
+
+        return await client.SendAsync(request);
+    }
+}
