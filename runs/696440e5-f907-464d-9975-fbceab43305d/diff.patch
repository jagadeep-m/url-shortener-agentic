+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class EncodedUtmNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateLinkRemovesUtmParametersWithEncodedNames()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new
+        {
+            longUrl = "HTTPS://ExAmPlE.com/path?%75tm_source=remove&keep=a%20b&utm%5Fcampaign=remove&UTM_source=preserved#section"
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        using var created = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.Equal(
+            "https://example.com/path?keep=a%20b&UTM_source=preserved#section",
+            created.RootElement.GetProperty("longUrl").GetString());
+    }
+}
