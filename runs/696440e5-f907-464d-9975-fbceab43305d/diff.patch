+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LinkNormalizationTests
+{
+    private sealed class FixedGenerator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private sealed class FixedClock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class RecordingRepository : ILinkCreationRepository, IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public int CreateCalls { get; private set; }
+        public ShortLink? CreatedLink { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            CreateCalls++;
+            CreatedLink = link;
+            return Task.FromResult(new CreationResult(CreationStatus.Created, link));
+        }
+
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken cancellationToken = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken cancellationToken = default) =>
+            throw new NotSupportedException();
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> DisableAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult(false);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private static LinkService CreateService(RecordingRepository repository) =>
+        new(new CreateLinkValidator(), repository, repository, repository, repository, new FixedGenerator(), new FixedClock());
+
+    [Theory]
+    [InlineData("HTTPS://ExAmPlE.COM/path", "https://example.com/path")]
+    [InlineData("HTTP://ExAmPlE.COM:80/path", "http://example.com/path")]
+    [InlineData("HTTPS://ExAmPlE.COM:443/path", "https://example.com/path")]
+    [InlineData("HTTP://ExAmPlE.COM:8080/path", "http://example.com:8080/path")]
+    public async Task CreateAsyncNormalizesSchemeHostAndPorts(string input, string expected)
+    {
+        var repository = new RecordingRepository();
+
+        var link = await CreateService(repository).CreateAsync(new(input), null, ["localhost"]);
+
+        Assert.Equal(expected, repository.CreatedLink!.LongUrl);
+        Assert.Equal(expected, link.LongUrl);
+        Assert.Equal(1, repository.CreateCalls);
+    }
+
+    [Fact]
+    public async Task CreateAsyncRemovesTrackingParametersAndPreservesOtherQueryOrderAndFragment()
+    {
+        var repository = new RecordingRepository();
+        const string expected = "https://example.com/path?first=1&keep=a%20b&last=3#section";
+
+        var link = await CreateService(repository).CreateAsync(
+            new("HTTPS://ExAmPlE.com:443/path?first=1&utm_source=newsletter&keep=a%20b&utm_campaign=spring&last=3#section"),
+            null,
+            ["localhost"]);
+
+        Assert.Equal(expected, repository.CreatedLink!.LongUrl);
+        Assert.Equal(expected, link.LongUrl);
+    }
+
+    [Fact]
+    public async Task CreateAsyncKeepsCaseSensitiveNonTrackingParameterNamesAndEscapedValues()
+    {
+        var repository = new RecordingRepository();
+        const string expected = "https://example.com/path?UTM_source=a%2Fb&query=a%20b#frag%20ment";
+
+        var link = await CreateService(repository).CreateAsync(
+            new("HTTPS://ExAmPlE.com/path?UTM_source=a%2Fb&utm_source=remove&query=a%20b#frag%20ment"),
+            null,
+            ["localhost"]);
+
+        Assert.Equal(expected, repository.CreatedLink!.LongUrl);
+        Assert.Equal(expected, link.LongUrl);
+    }
+
+    [Theory]
+    [InlineData("https://example.com/path?utm_source=one&utm_campaign=two", "https://example.com/path")]
+    [InlineData("https://example.com/path?keep=1&utm_source=one", "https://example.com/path?keep=1")]
+    public async Task CreateAsyncOmitsQueryWhenNoParametersRemain(string input, string expected)
+    {
+        var repository = new RecordingRepository();
+
+        var link = await CreateService(repository).CreateAsync(new(input), null, ["localhost"]);
+
+        Assert.Equal(expected, repository.CreatedLink!.LongUrl);
+        Assert.Equal(expected, link.LongUrl);
+    }
+
+    [Theory]
+    [InlineData("ftp://example.com/path")]
+    [InlineData("not a URL")]
+    public async Task InvalidDestinationDoesNotReachCreationRepository(string input)
+    {
+        var repository = new RecordingRepository();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(repository).CreateAsync(new(input), null, ["localhost"]));
+
+        Assert.Equal(0, repository.CreateCalls);
+        Assert.Null(repository.CreatedLink);
+    }
+
+    [Fact]
+    public async Task OwnHostDestinationDoesNotReachCreationRepository()
+    {
+        var repository = new RecordingRepository();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(repository).CreateAsync(new("https://short.example/path?utm_source=x"), null, ["short.example"]));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Equal(0, repository.CreateCalls);
+        Assert.Null(repository.CreatedLink);
+    }
+}
