+    /// <summary>
+    /// Lowercases the URL scheme and host, removes the scheme's default port, and removes
+    /// query parameters whose names start with <c>utm_</c> without regard to case. Other
+    /// query parameter text and ordering, as well as the fragment, are preserved.
+    /// </summary>
+    private static string NormalizeUrl(string url, Uri parsed)
+    {
+        var separator = url.IndexOf("://", StringComparison.Ordinal);
+        var schemeEnd = url.IndexOf(':');
+        if (separator <= 0 || separator != schemeEnd
+            || !(url.AsSpan(0, schemeEnd).Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
+                || url.AsSpan(0, schemeEnd).Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)))
+            throw new ArgumentException("The URL must contain an absolute HTTP(S) scheme and authority.", nameof(url));
+
+        var authorityStart = separator + 3;
+        if (authorityStart >= url.Length)
+            throw new ArgumentException("The URL must contain a non-empty authority.", nameof(url));
+
+        var authorityEnd = url.IndexOfAny(['/','?', '#'], authorityStart);
+        if (authorityEnd < 0) authorityEnd = url.Length;
+        if (authorityEnd == authorityStart)
+            throw new ArgumentException("The URL must contain a non-empty authority.", nameof(url));
+
+        var authority = url.AsSpan(authorityStart, authorityEnd - authorityStart);
+        var userInfoEnd = authority.LastIndexOf('@');
+        var hostStart = userInfoEnd >= 0 ? userInfoEnd + 1 : 0;
+        var hostEnd = authority.Length;
+        var portStart = -1;
+
+        if (hostStart < authority.Length && authority[hostStart] == '[')
+        {
+            var closingBracket = authority[hostStart..].IndexOf(']');
+            if (closingBracket >= 0)
+            {
+                hostEnd = hostStart + closingBracket + 1;
+                if (hostEnd < authority.Length && authority[hostEnd] == ':') portStart = hostEnd;
+            }
+        }
+        else if (hostStart < authority.Length)
+        {
+            var colon = authority[hostStart..].LastIndexOf(':');
+            if (colon >= 0)
+            {
+                portStart = hostStart + colon;
+                hostEnd = portStart;
+            }
+        }
+
+        var removePort = false;
+        if (portStart >= 0 && int.TryParse(authority[(portStart + 1)..], NumberStyles.None,
+                CultureInfo.InvariantCulture, out var port))
+        {
+            removePort = (parsed.Scheme.Equals(Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase) && port == 80)
+                || (parsed.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) && port == 443);
+        }
+
+        var builder = new StringBuilder(url.Length);
+        builder.Append(url.AsSpan(0, schemeEnd).ToString().ToLowerInvariant());
+        builder.Append("://");
+        builder.Append(authority[..hostStart]);
+        builder.Append(authority[hostStart..hostEnd].ToString().ToLowerInvariant());
+        if (!removePort && portStart >= 0) builder.Append(authority[portStart..]);
+        else if (portStart < 0) builder.Append(authority[hostEnd..]);
+        builder.Append(url.AsSpan(authorityEnd));
+
+        var normalizedAuthorityAndRemainder = builder.ToString();
+        var queryStart = normalizedAuthorityAndRemainder.IndexOf('?', schemeEnd + 3);
+        if (queryStart < 0) return normalizedAuthorityAndRemainder;
+
+        var fragmentStart = normalizedAuthorityAndRemainder.IndexOf('#', queryStart + 1);
+        var queryEnd = fragmentStart < 0 ? normalizedAuthorityAndRemainder.Length : fragmentStart;
+        var query = normalizedAuthorityAndRemainder.AsSpan(queryStart + 1, queryEnd - queryStart - 1);
+        if (query.IsEmpty)
+            return string.Concat(normalizedAuthorityAndRemainder.AsSpan(0, queryStart),
+                normalizedAuthorityAndRemainder.AsSpan(queryEnd));
+
+        var retainedParameters = new List<string>();
+        var queryText = query.ToString();
+        foreach (var parameter in queryText.Split('&'))
+        {
+            var equals = parameter.IndexOf('=');
+            var name = equals < 0 ? parameter : parameter[..equals];
+            if (!name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase))
+                retainedParameters.Add(parameter);
+        }
+
+        if (retainedParameters.Count == 0)
+            return string.Concat(normalizedAuthorityAndRemainder.AsSpan(0, queryStart),
+                normalizedAuthorityAndRemainder.AsSpan(queryEnd));
+
+        return string.Concat(normalizedAuthorityAndRemainder.AsSpan(0, queryStart + 1),
+            string.Join('&', retainedParameters), normalizedAuthorityAndRemainder.AsSpan(queryEnd));
+    }
+
     private static bool IsLoopbackHost(string host) => host.TrimEnd('.').Equals("localhost", StringComparison.OrdinalIgnoreCase)
         || (IPAddress.TryParse(host.Trim('[', ']'), out var address) && IPAddress.IsLoopback(address));
 
