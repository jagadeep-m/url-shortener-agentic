@@ -0,0 +1,32 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlValidationBoundaryTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Theory]
+    [InlineData("http:example.com/path")]
+    [InlineData("https:/example.com/path")]
+    [InlineData("http://?utm_source=campaign")]
+    public async Task HttpUrlWithoutRequiredSeparatorOrHostReturnsValidationProblem(string url)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links",
+            new CreateLinkRequest(url));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+
+        var body = await response.Content.ReadAsStringAsync();
+        using var problemDocument = JsonDocument.Parse(body);
+        var problem = problemDocument.RootElement;
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+        Assert.True(problem.TryGetProperty("errors", out var errors));
+        Assert.True(errors.EnumerateObject().Any());
+    }
+}
