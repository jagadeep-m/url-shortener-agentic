+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.COM:80/path?utm_source=google&keep=One&utm_medium=email&x=%2f#Section",
+        "http://example.com/path?keep=One&x=%2f#Section")]
+    [InlineData(
+        "HtTpS://EXAMPLE.COM:443/docs?Keep=Case&utm_campaign=spring&next=a%2Bb#part",
+        "https://example.com/docs?Keep=Case&next=a%2Bb#part")]
+    [InlineData(
+        "HtTp://ExAmPlE.CoM:8080/path?utm_source=x&z=1",
+        "http://example.com:8080/path?z=1")]
+    [InlineData(
+        "HTTPS://Example.COM/path?UTM_source=one&Utm_Medium=two#fragment",
+        "https://example.com/path#fragment")]
+    [InlineData(
+        "https://Example.COM/path?utm_source=only",
+        "https://example.com/path")]
+    [InlineData(
+        "https://ExAmPlE.com/path?first=1&utm_term=ignored&second=2#keep",
+        "https://example.com/path?first=1&second=2#keep")]
+    public async Task CreateAndRetrieveExposeNormalizedDestination(string submittedUrl, string expectedUrl)
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(submittedUrl));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal("application/json", response.Content.Headers.ContentType!.MediaType);
+        var created = await response.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(created);
+        Assert.Equal(expectedUrl, created.LongUrl);
+        Assert.Equal($"/api/v1/links/{created.Code}", response.Headers.Location!.OriginalString);
+        Assert.Equal($"http://localhost/{created.Code}", created.ShortUrl);
+
+        using var detailsResponse = await client.GetAsync($"/api/v1/links/{created.Code}");
+        Assert.Equal(HttpStatusCode.OK, detailsResponse.StatusCode);
+        var details = await detailsResponse.Content.ReadFromJsonAsync<LinkDetails>();
+        Assert.NotNull(details);
+        Assert.Equal(created.Code, details.Code);
+        Assert.Equal(expectedUrl, details.LongUrl);
+    }
+
+    [Fact]
+    public async Task InvalidUrlReturnsProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync(
+            "/api/v1/links",
+            new CreateLinkRequest("ftp://example.com/path?utm_source=ignored"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+    }
+}
