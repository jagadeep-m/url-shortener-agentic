+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class UrlNormalizerTests
+{
+    [Theory]
+    [InlineData("HTTP://ExAmPlE.com:80/docs", "http://example.com/docs")]
+    [InlineData("https://EXAMPLE.com:443/path#section", "https://example.com/path#section")]
+    [InlineData("https://EXAMPLE.com:8443/a", "https://example.com:8443/a")]
+    public void NormalizeLowercasesSchemeAndHostAndRemovesOnlyDefaultPorts(string input, string expected)
+    {
+        Assert.Equal(expected, UrlNormalizer.Normalize(input));
+    }
+
+    [Theory]
+    [InlineData(
+        "https://EXAMPLE.com:443/path?keep=1&utm_source=x#frag",
+        "https://example.com/path?keep=1#frag")]
+    [InlineData(
+        "https://example.com/path?utm_source=x#frag",
+        "https://example.com/path#frag")]
+    [InlineData(
+        "https://example.com/path?%75tm_source=x&Keep=a%2Fb",
+        "https://example.com/path?Keep=a%2Fb")]
+    [InlineData(
+        "https://example.com/path?not_utm_source=x&UTM_campaign=spring",
+        "https://example.com/path?not_utm_source=x")]
+    public void NormalizeRemovesUtmParametersAndPreservesOtherUrlComponents(string input, string expected)
+    {
+        Assert.Equal(expected, UrlNormalizer.Normalize(input));
+    }
+
+    [Fact]
+    public void NormalizePreservesEmptyNonTrackingQueryParameters()
+    {
+        Assert.Equal(
+            "https://example.com/path?&&keep=1&#frag",
+            UrlNormalizer.Normalize("https://example.com/path?&&utm_source=x&keep=1&#frag"));
+    }
+
+    [Fact]
+    public void NormalizeRejectsNullInput()
+    {
+        Assert.Throws<ArgumentNullException>(() => UrlNormalizer.Normalize(null!));
+    }
+}
