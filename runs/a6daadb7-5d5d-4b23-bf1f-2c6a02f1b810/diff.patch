+namespace UrlShortener.Application.Links;
+
+/// <summary>
+/// Normalizes the URL components required for newly created links while preserving the
+/// original text of unaffected components.
+/// </summary>
+public static class UrlNormalizer
+{
+    public static string Normalize(string url)
+    {
+        ArgumentNullException.ThrowIfNull(url);
+
+        var schemeSeparator = url.IndexOf("://", StringComparison.Ordinal);
+        if (schemeSeparator < 0)
+        {
+            // Uri accepts a small number of alternate spellings (such as backslashes) and
+            // can provide the standard authority form for those inputs.
+            if (Uri.TryCreate(url, UriKind.Absolute, out var parsed))
+                url = parsed.AbsoluteUri;
+            schemeSeparator = url.IndexOf("://", StringComparison.Ordinal);
+            if (schemeSeparator < 0)
+                return url;
+        }
+
+        var scheme = url[..schemeSeparator].ToLowerInvariant();
+        var authorityStart = schemeSeparator + 3;
+        var authorityEnd = FindAuthorityEnd(url, authorityStart);
+        var authority = NormalizeAuthority(url[authorityStart..authorityEnd], scheme);
+        var suffix = StripTrackingParameters(url[authorityEnd..]);
+
+        return string.Concat(scheme, url[schemeSeparator..authorityStart], authority, suffix);
+    }
+
+    private static int FindAuthorityEnd(string url, int authorityStart)
+    {
+        var end = url.Length;
+        foreach (var delimiter in new[] { '/', '?', '#' })
+        {
+            var index = url.IndexOf(delimiter, authorityStart);
+            if (index >= 0 && index < end)
+                end = index;
+        }
+        return end;
+    }
+
+    private static string NormalizeAuthority(string authority, string scheme)
+    {
+        var hostStart = authority.LastIndexOf('@') + 1;
+        var hostEnd = authority.Length;
+        var portStart = -1;
+
+        if (hostStart < authority.Length && authority[hostStart] == '[')
+        {
+            var closingBracket = authority.IndexOf(']', hostStart);
+            if (closingBracket >= 0)
+            {
+                hostEnd = closingBracket + 1;
+                if (hostEnd < authority.Length && authority[hostEnd] == ':')
+                    portStart = hostEnd;
+            }
+        }
+        else
+        {
+            var colon = authority.LastIndexOf(':');
+            if (colon >= hostStart)
+            {
+                hostEnd = colon;
+                portStart = colon;
+            }
+        }
+
+        var host = authority[hostStart..hostEnd].ToLowerInvariant();
+        var port = portStart >= 0 ? authority[(portStart + 1)..] : string.Empty;
+        var removeDefaultPort = portStart >= 0
+            && int.TryParse(port, System.Globalization.NumberStyles.None,
+                System.Globalization.CultureInfo.InvariantCulture, out var portNumber)
+            && ((scheme == Uri.UriSchemeHttp && portNumber == 80)
+                || (scheme == Uri.UriSchemeHttps && portNumber == 443));
+
+        var authorityPrefix = authority[..hostStart];
+        var authoritySuffix = portStart < 0
+            ? authority[hostEnd..]
+            : removeDefaultPort
+                ? string.Empty
+                : authority[portStart..];
+        return string.Concat(authorityPrefix, host, authoritySuffix);
+    }
+
+    private static string StripTrackingParameters(string suffix)
+    {
+        var queryStart = suffix.IndexOf('?');
+        if (queryStart < 0)
+            return suffix;
+
+        var fragmentStart = suffix.IndexOf('#', queryStart);
+        var queryEnd = fragmentStart >= 0 ? fragmentStart : suffix.Length;
+        var query = suffix[(queryStart + 1)..queryEnd];
+        var parameters = query.Split('&');
+        var retained = new List<string>(parameters.Length);
+        var removedAny = false;
+
+        foreach (var parameter in parameters)
+        {
+            var equals = parameter.IndexOf('=');
+            var encodedName = equals >= 0 ? parameter[..equals] : parameter;
+            var name = Uri.UnescapeDataString(encodedName);
+            if (name.StartsWith("utm_", StringComparison.OrdinalIgnoreCase))
+            {
+                removedAny = true;
+                continue;
+            }
+            retained.Add(parameter);
+        }
+
+        if (!removedAny)
+            return suffix;
+
+        var prefix = suffix[..queryStart];
+        var fragment = fragmentStart >= 0 ? suffix[fragmentStart..] : string.Empty;
+        return retained.Count == 0
+            ? string.Concat(prefix, fragment)
+            : string.Concat(prefix, "?", string.Join('&', retained), fragment);
+    }
+}
