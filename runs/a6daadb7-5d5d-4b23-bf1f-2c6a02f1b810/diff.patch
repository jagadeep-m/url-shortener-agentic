+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using UrlShortener.Application.Links;
+using Xunit;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class UrlNormalizationApiTests(ApiFactory factory) : IClassFixture<ApiFactory>
+{
+    [Fact]
+    public async Task CreateDetailsAndRedirectUseNormalizedSavedDestination()
+    {
+        using var client = factory.Client();
+        const string expectedUrl = "http://example.com/docs?Keep=a%2Fb#section";
+        using var createdResponse = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(
+            "HTTP://ExAmPlE.COM:80/docs?utm_source=campaign&Keep=a%2Fb#section"));
+
+        Assert.Equal(HttpStatusCode.Created, createdResponse.StatusCode);
+        var created = await createdResponse.Content.ReadFromJsonAsync<LinkResponse>();
+        Assert.NotNull(created);
+        Assert.Equal(expectedUrl, created.LongUrl);
+
+        var details = await client.GetFromJsonAsync<LinkDetails>($"/api/v1/links/{created.Code}");
+        Assert.NotNull(details);
+        Assert.Equal(expectedUrl, details.LongUrl);
+
+        using var redirect = await client.GetAsync($"/{created.Code}");
+        Assert.Equal(HttpStatusCode.Found, redirect.StatusCode);
+        Assert.NotNull(redirect.Headers.Location);
+        Assert.Equal(expectedUrl, redirect.Headers.Location.OriginalString);
+    }
+
+    [Fact]
+    public async Task CreationStillRejectsServiceHostTargetAsProblemDetails()
+    {
+        using var client = factory.Client();
+        using var response = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest(
+            "HTTP://LOCALHOST:80/path?utm_source=campaign"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType!.MediaType);
+        var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal((int)HttpStatusCode.BadRequest, problem.GetProperty("status").GetInt32());
+    }
+}
