+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using FluentValidation;
+using UrlShortener.Application.Links;
+using UrlShortener.Application.Repositories;
+using UrlShortener.Domain;
+using Xunit;
+
+namespace UrlShortener.UnitTests;
+
+public sealed class LinkNormalizationTests
+{
+    private sealed class Clock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2026, 10, 17, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class Generator : ICodeGenerator
+    {
+        public string Generate() => "Abc1234";
+    }
+
+    private sealed class Repository : ILinkCreationRepository, IShortLinkRepository, IRedirectStore, ILinkStatsRepository
+    {
+        public ShortLink? AttemptedLink { get; private set; }
+        public string? AttemptedRequestHash { get; private set; }
+        public CreationStatus ResultStatus { get; init; } = CreationStatus.Created;
+        public int CreateCalls { get; private set; }
+
+        public Task<IdempotentLink?> FindByKeyAsync(string key, CancellationToken ct) =>
+            Task.FromResult<IdempotentLink?>(null);
+
+        public Task<CreationResult> TryCreateAsync(ShortLink link, string? key, string requestHash, CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            CreateCalls++;
+            AttemptedLink = link;
+            AttemptedRequestHash = requestHash;
+            return Task.FromResult(ResultStatus == CreationStatus.Created
+                ? new CreationResult(CreationStatus.Created, link)
+                : new CreationResult(ResultStatus));
+        }
+
+        public Task<ShortLink?> FindByCodeAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<ShortLink?> FindAsync(string code, CancellationToken ct) =>
+            Task.FromResult<ShortLink?>(null);
+
+        public Task<bool> TryAddAsync(ShortLink link, CancellationToken ct = default) =>
+            throw new NotSupportedException();
+
+        public Task<bool> DisableAsync(string code, CancellationToken ct = default) =>
+            Task.FromResult(false);
+
+        public Task<LinkStats> GetAsync(long linkId, CancellationToken ct) =>
+            throw new NotSupportedException();
+    }
+
+    private static LinkService CreateService(Repository repository) =>
+        new(new CreateLinkValidator(), repository, repository, repository, repository, new Generator(), new Clock());
+
+    [Theory]
+    [InlineData(
+        "HTTP://ExAmPlE.com:80/docs?utm_source=campaign&Keep=a%2Fb&UTM_campaign=spring#section",
+        "http://example.com/docs?Keep=a%2Fb#section")]
+    [InlineData(
+        "https://EXAMPLE.com:443/path?keep=1&utm_source=x&Keep=2",
+        "https://example.com/path?keep=1&Keep=2")]
+    [InlineData(
+        "https://EXAMPLE.com:8443/a?not_utm_source=x&utm_id=y#frag",
+        "https://example.com:8443/a?not_utm_source=x#frag")]
+    [InlineData(
+        "https://example.com/path?%75tm_source=campaign&keep=value",
+        "https://example.com/path?keep=value")]
+    public async Task CreateSavesNormalizedDestinationAndHashesOriginalRequest(string submittedUrl, string expectedUrl)
+    {
+        var repository = new Repository();
+        var request = new CreateLinkRequest(submittedUrl);
+
+        var created = await CreateService(repository).CreateAsync(request, null, ["localhost"]);
+
+        Assert.Equal(expectedUrl, created.LongUrl);
+        Assert.Equal(expectedUrl, Assert.IsType<ShortLink>(repository.AttemptedLink).LongUrl);
+        var expectedHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(request))));
+        Assert.Equal(expectedHash, repository.AttemptedRequestHash);
+        Assert.Equal(1, repository.CreateCalls);
+    }
+
+    [Fact]
+    public async Task UTMOnlyQueryIsRemovedWithoutLeavingQuestionMark()
+    {
+        var repository = new Repository();
+
+        var created = await CreateService(repository).CreateAsync(
+            new CreateLinkRequest("https://example.com/path?utm_source=campaign#section"), null, ["localhost"]);
+
+        Assert.Equal("https://example.com/path#section", created.LongUrl);
+        Assert.DoesNotContain("?", created.LongUrl);
+    }
+
+    [Fact]
+    public async Task InvalidRequestFailsBeforeAttemptingPersistence()
+    {
+        var repository = new Repository();
+
+        await Assert.ThrowsAsync<ValidationException>(() =>
+            CreateService(repository).CreateAsync(new CreateLinkRequest("not-an-absolute-url"), null, ["localhost"]));
+
+        Assert.Equal(0, repository.CreateCalls);
+        Assert.Null(repository.AttemptedLink);
+    }
+
+    [Fact]
+    public async Task ServiceHostRejectionStillOccursBeforeAttemptingPersistence()
+    {
+        var repository = new Repository();
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(repository).CreateAsync(
+                new CreateLinkRequest("HTTP://LOCALHOST:80/path?utm_source=campaign"), null, ["localhost"]));
+
+        Assert.Equal(400, exception.StatusCode);
+        Assert.Equal(0, repository.CreateCalls);
+        Assert.Null(repository.AttemptedLink);
+    }
+
+    [Fact]
+    public async Task CustomAliasConflictRemainsAConflictAndDoesNotRetry()
+    {
+        var repository = new Repository { ResultStatus = CreationStatus.CodeConflict };
+
+        var exception = await Assert.ThrowsAsync<LinkOperationException>(() =>
+            CreateService(repository).CreateAsync(
+                new CreateLinkRequest("HTTP://ExAmPlE.com:80/path?utm_source=campaign", "custom-alias"), null, ["localhost"]));
+
+        Assert.Equal(409, exception.StatusCode);
+        Assert.Equal(1, repository.CreateCalls);
+        Assert.Equal("http://example.com/path", Assert.IsType<ShortLink>(repository.AttemptedLink).LongUrl);
+    }
+}
